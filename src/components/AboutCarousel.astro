---
interface Props { lang: 'en' | 'el' }
const { lang } = Astro.props;
const isEl = lang === 'el';
const slides = isEl
  ? [
      { name: 'Καφές', text: 'Ο δυνατός καφές είναι μια μικρή καθημερινή σταθερά.', image: '/media/images/coffee.webp' },
      { name: 'Ταξίδια', text: 'Μου αρέσει να γνωρίζω μια πόλη περπατώντας τη χωρίς βιασύνη.', image: '/media/images/travel.webp' },
      { name: 'Σειρές', text: 'Μια καλή σειρά είναι πάντα ευπρόσδεκτη.', image: '/media/images/series.webp' },
      { name: 'Formula 1', text: 'Στους αγώνες παρακολουθώ τη στρατηγική όσο και τη δράση.', image: '/media/images/f1.webp' },
      { name: 'Μουσική', text: 'Τα ρεμπέτικα είναι από τους ήχους στους οποίους επιστρέφω.', image: '/media/images/music.webp' },
    ]
  : [
      { name: 'Coffee', text: 'Strong coffee is a small daily constant.', image: '/media/images/coffee.webp' },
      { name: 'Travel', text: 'I like getting to know a city by walking it without a schedule.', image: '/media/images/travel.webp' },
      { name: 'Series', text: 'A good series is always welcome.', image: '/media/images/series.webp' },
      { name: 'Formula 1', text: 'I follow the strategy as closely as the action.', image: '/media/images/f1.webp' },
      { name: 'Music', text: 'Rembetika is one of the sounds I keep returning to.', image: '/media/images/music.webp' },
    ];
---

<div data-about-carousel data-slides={JSON.stringify(slides)}>
  <div class="relative overflow-hidden rounded-[1.75rem] border border-slate-700 bg-slate-900 shadow-lg">
    <img class="about-slide-image absolute inset-0 h-full w-full object-cover opacity-55" src={slides[0].image} alt="" width="1400" height="500" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-slate-950/35 to-transparent"></div>
    <div class="relative flex min-h-72 items-end p-7 sm:min-h-80 sm:p-10">
      <div>
        <p class="about-slide-name mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-orange-300">{slides[0].name}</p>
        <p class="about-slide-text max-w-2xl text-2xl font-semibold leading-tight text-white drop-shadow-lg sm:text-[2.15rem]" aria-live="off" aria-atomic="true">{slides[0].text}</p>
      </div>
    </div>
  </div>
  <div class="mt-3 flex flex-wrap items-center justify-center gap-3" role="group" aria-label={isEl ? 'Χειριστήρια παρουσίασης' : 'Slideshow controls'}>
    <div class="flex items-center">
      {slides.map((slide, index) => (
        <button
          type="button"
          class:list={["about-slide-dot h-11 w-11 rounded-full border-[14px] border-transparent bg-clip-padding focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500", index === 0 ? 'bg-orange-400' : 'bg-slate-400']}
          data-index={index}
          aria-label={slide.name}
          aria-pressed={index === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
    <button type="button" class="about-slide-playback min-h-11 rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-orange-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 dark:border-slate-600 dark:text-slate-200" aria-pressed="false">
      {isEl ? 'Παύση διαφανειών' : 'Pause slides'}
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-about-carousel]').forEach((carousel) => {
    const slides = JSON.parse(carousel.dataset.slides ?? '[]') as Array<{ name: string; text: string; image: string }>;
    const image = carousel.querySelector<HTMLImageElement>('.about-slide-image');
    const name = carousel.querySelector<HTMLElement>('.about-slide-name');
    const text = carousel.querySelector<HTMLElement>('.about-slide-text');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('.about-slide-dot');
    const playback = carousel.querySelector<HTMLButtonElement>('.about-slide-playback');
    const isEl = document.documentElement.lang === 'el';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let userPaused = reducedMotion.matches;
    let inView = false;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(index: number) {
      current = index;
      if (image) image.src = slides[index].image;
      if (name) name.textContent = slides[index].name;
      if (text) text.textContent = slides[index].text;
      dots.forEach((dot, position) => {
        dot.classList.toggle('bg-orange-400', position === index);
        dot.classList.toggle('bg-slate-400', position !== index);
        dot.setAttribute('aria-pressed', String(position === index));
      });
    }

    function sync() {
      if (timer) clearInterval(timer);
      timer = undefined;
      if (!userPaused && inView && !document.hidden) {
        timer = setInterval(() => show((current + 1) % slides.length), 10000);
      }
      text?.setAttribute('aria-live', userPaused ? 'polite' : 'off');
      if (playback) {
        playback.textContent = userPaused
          ? (isEl ? 'Αναπαραγωγή διαφανειών' : 'Play slides')
          : (isEl ? 'Παύση διαφανειών' : 'Pause slides');
        playback.setAttribute('aria-pressed', String(userPaused));
      }
    }

    dots.forEach((dot) => dot.addEventListener('click', () => {
      show(Number(dot.dataset.index ?? 0));
      userPaused = true;
      sync();
    }));
    playback?.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) userPaused = true;
      sync();
    });
    document.addEventListener('visibilitychange', sync);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        inView = entries.some((entry) => entry.isIntersecting);
        sync();
      }, { threshold: 0.35 });
      observer.observe(carousel);
    } else {
      inView = true;
      sync();
    }
    sync();
  });
</script>
