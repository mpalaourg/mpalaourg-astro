---
import {
  championCarModels,
  constructorCarModels,
  constructorChampions,
  driverChampions,
  teamColours,
  type ConstructorChampion,
  type DriverChampion,
} from "../data/f1Champions";
import { constructorSeasonStats, driverSeasonStats } from "../data/f1ChampionStats";

interface Props {
  lang?: "en" | "el";
}

const { lang = "en" } = Astro.props;
const isEl = lang === "el";

const copy = isEl
  ? {
      eyebrow: "FORMULA 1 · ΑΡΧΕΙΟ 1950—2025",
      titleLead: "Η ΑΙΘΟΥΣΑ ΤΩΝ",
      titleAccent: "ΠΡΩΤΑΘΛΗΤΩΝ",
      intro: "Κάθε στέμμα. Κάθε εποχή. Όλοι οι Παγκόσμιοι Πρωταθλητές της Formula 1, σε μία χρονογραμμή.",
      drivers: "Οδηγοί",
      constructors: "Κατασκευαστές",
      driverTab: "Πρωταθλητές Οδηγών",
      constructorTab: "Πρωταθλητές Κατασκευαστών",
      seasons: "σεζόν",
      champions: "διαφορετικοί πρωταθλητές",
      constructorSeasons: "σεζόν πρωταθλήματος",
      constructorsCount: "διαφορετικοί κατασκευαστές",
      year: "Σεζόν",
      carNumber: "Αριθμός μονοθεσίου",
      team: "Ομάδα",
      title: "Τίτλος",
      car: "Μονοθέσιο",
      readArticle: "Άνοιγμα ανάλυσης σεζόν",
      varied: "Μεταβαλλόμενος",
      numberNote: "Πριν από το 1974 οι αριθμοί αποδίδονταν ανά αγώνα και δεν ήταν σταθεροί για ολόκληρη τη σεζόν.",
      constructorNote: "Το Πρωτάθλημα Κατασκευαστών θεσπίστηκε το 1958· γι’ αυτό η χρονογραμμή ξεκινά οκτώ χρόνια μετά από εκείνη των οδηγών.",
      allTime: "ALL-TIME TOP 5",
      driverLeaders: "Οι πολυνίκες οδηγοί",
      constructorLeaders: "Οι πολυνίκες κατασκευαστές",
      titles: "τίτλοι",
      latest: "ΤΕΛΕΥΤΑΙΟΣ ΠΡΩΤΑΘΛΗΤΗΣ",
      source: "Πηγές δεδομένων",
      seasonStats: "Στατιστικά σεζόν",
      driver: "Οδηγός",
      wins: "Νίκες",
      podiums: "Βάθρα",
      poles: "Pole",
      dnfs: "DNF",
      points: "Βαθμοί",
      constructorPoints: "Βαθμοί κατασκευαστή",
      total: "Σύνολο",
      flipHint: "Στατιστικά",
      back: "Πίσω στη Formula",
    }
  : {
      eyebrow: "FORMULA 1 · ARCHIVE 1950—2025",
      titleLead: "THE HALL OF",
      titleAccent: "CHAMPIONS",
      intro: "Every crown. Every era. Every Formula 1 World Champion, arranged on one continuous timeline.",
      drivers: "Drivers",
      constructors: "Constructors",
      driverTab: "World Drivers’ Champions",
      constructorTab: "World Constructors’ Champions",
      seasons: "championship seasons",
      champions: "different champions",
      constructorSeasons: "championship seasons",
      constructorsCount: "different constructors",
      year: "Season",
      carNumber: "Car number",
      team: "Team",
      title: "Title",
      car: "Car",
      readArticle: "Open season analysis",
      varied: "Varied",
      numberNote: "Before 1974, car numbers were allocated race by race rather than fixed for an entire season.",
      constructorNote: "The Constructors’ Championship began in 1958, so its timeline starts eight years after the drivers’ competition.",
      allTime: "ALL-TIME TOP 5",
      driverLeaders: "The most decorated drivers",
      constructorLeaders: "The most decorated constructors",
      titles: "titles",
      latest: "LATEST CHAMPION",
      source: "Data sources",
      seasonStats: "Season stats",
      driver: "Driver",
      wins: "Wins",
      podiums: "Podiums",
      poles: "Poles",
      dnfs: "DNF",
      points: "Points",
      constructorPoints: "Constructor points",
      total: "Total",
      flipHint: "Stats",
      back: "Back to Formula",
    };

const uniqueDrivers = new Set(driverChampions.map((champion) => champion.name)).size;
const uniqueConstructors = new Set(constructorChampions.map((champion) => champion.team)).size;

const titleAtSeason = <T extends DriverChampion | ConstructorChampion>(
  entries: T[],
  entry: T,
  key: "name" | "team",
) => entries.filter((candidate) => candidate.year <= entry.year && candidate[key as keyof T] === entry[key as keyof T]).length;

const groupByDecade = <T extends { year: number }>(entries: T[]) => {
  const groups = new Map<number, T[]>();
  entries.forEach((entry) => {
    const decade = Math.floor(entry.year / 10) * 10;
    groups.set(decade, [...(groups.get(decade) ?? []), entry]);
  });
  return [...groups.entries()];
};

const driverDecades = groupByDecade(driverChampions);
const constructorDecades = groupByDecade(constructorChampions);
const driverLeaders = [...new Set(driverChampions.map((entry) => entry.name))]
  .map((name) => {
    const seasons = driverChampions.filter((entry) => entry.name === name);
    return {
      name,
      titles: seasons.length,
      lastYear: Math.max(...seasons.map((entry) => entry.year)),
      teamKey: seasons[0].teamKey,
    };
  })
  .sort((a, b) => b.titles - a.titles || b.lastYear - a.lastYear)
  .slice(0, 5);
const constructorLeaders = [...new Set(constructorChampions.map((entry) => entry.team))]
  .map((name) => {
    const seasons = constructorChampions.filter((entry) => entry.team === name);
    return {
      name,
      titles: seasons.length,
      lastYear: Math.max(...seasons.map((entry) => entry.year)),
      teamKey: seasons[0].teamKey,
    };
  })
  .sort((a, b) => b.titles - a.titles || b.lastYear - a.lastYear)
  .slice(0, 5);
const articleYears = new Set([2020, 2021, 2022, 2023, 2024, 2025]);
const teamLogos: Record<string, string> = {
  mclaren: "/formula/team-logos/mclaren.png",
  "red-bull": "/formula/team-logos/red_bull.png",
  mercedes: "/formula/team-logos/mercedes.svg",
  ferrari: "/formula/team-logos/ferrari.svg",
  williams: "/formula/team-logos/williams.svg",
  renault: "/formula/team-logos/champions/renault.svg",
  brawn: "/formula/team-logos/champions/brawn.svg",
  benetton: "/formula/team-logos/champions/benetton.png",
  brabham: "/formula/team-logos/champions/brabham.png",
  lotus: "/formula/team-logos/champions/lotus.jpg",
  tyrrell: "/formula/team-logos/champions/tyrrell.svg",
  matra: "/formula/team-logos/champions/matra.svg",
  brm: "/formula/team-logos/champions/brm.png",
  cooper: "/formula/team-logos/champions/cooper.png",
  vanwall: "/formula/team-logos/champions/vanwall.png",
  "alfa-romeo": "/formula/team-logos/champions/alfa-romeo.png",
  maserati: "/formula/team-logos/champions/maserati.svg",
};
const articlePath = (year: number) => `${isEl ? "/el" : ""}/formula/${year}-season`;
const ordinalSuffix = (number: number) => {
  if (isEl) return "ος";
  const remainder = number % 100;
  if (remainder >= 11 && remainder <= 13) return "th";
  if (number % 10 === 1) return "st";
  if (number % 10 === 2) return "nd";
  if (number % 10 === 3) return "rd";
  return "th";
};
---

<main class="champions-page">
  <div class="track-lines" aria-hidden="true"></div>

  <header class="champions-hero">
    <a class="back-link" href={isEl ? "/el/formula" : "/formula"}>← {copy.back}</a>
    <p class="eyebrow">{copy.eyebrow}</p>
    <div class="hero-layout">
      <h1>
        <span>{copy.titleLead}</span>
        <strong>{copy.titleAccent}</strong>
      </h1>
      <p class="intro">{copy.intro}</p>
    </div>
  </header>

  <div class="archive-shell">
    <div class="championship-switch" role="tablist" aria-label={isEl ? "Επιλογή πρωταθλήματος" : "Choose championship"}>
      <button class="switch-button is-active" type="button" role="tab" aria-selected="true" aria-controls="drivers-panel" id="drivers-tab" data-view="drivers">
        <span class="switch-index">01</span>
        <span>{copy.drivers}</span>
        <small>1950—2025</small>
      </button>
      <button class="switch-button" type="button" role="tab" aria-selected="false" aria-controls="constructors-panel" id="constructors-tab" data-view="constructors" tabindex="-1">
        <span class="switch-index">02</span>
        <span>{copy.constructors}</span>
        <small>1958—2025</small>
      </button>
    </div>

    <section class="archive-panel" id="drivers-panel" role="tabpanel" aria-labelledby="drivers-tab" data-panel="drivers">
      <div class="panel-heading">
        <div>
          <p class="panel-kicker">{copy.latest} · 2025</p>
          <h2>{copy.driverTab}</h2>
        </div>
        <div class="panel-stats">
          <p><strong>{driverChampions.length}</strong><span>{copy.seasons}</span></p>
          <p><strong>{uniqueDrivers}</strong><span>{copy.champions}</span></p>
        </div>
      </div>

      <p class="history-note"><span aria-hidden="true">#</span>{copy.numberNote}</p>

      <section class="leaderboard" aria-labelledby="driver-leaders-title">
        <header class="leaderboard-heading">
          <p>{copy.allTime}</p>
          <h3 id="driver-leaders-title">{copy.driverLeaders}</h3>
        </header>
        <div class="leader-grid">
          {driverLeaders.map((leader, index) => (
            <article
              class:list={["leader-card", { "is-record-holder": index === 0 }]}
              style={`--team:${teamColours[leader.teamKey]};--score:${(leader.titles / driverLeaders[0].titles) * 100}%`}
            >
              <span class="leader-rank">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h4>{leader.name}</h4>
                <p><strong>{leader.titles}</strong> {copy.titles} <span>({leader.lastYear})</span></p>
              </div>
              <i aria-hidden="true"></i>
            </article>
          ))}
        </div>
      </section>

      <div class="timeline">
        {driverDecades.map(([decade, entries]) => (
          <section class="decade-block" aria-labelledby={`drivers-${decade}`}>
            <div class="decade-label">
              <span id={`drivers-${decade}`}>{decade}s</span>
              <i></i>
            </div>
            <div class="champion-grid">
              {entries.map((champion) => {
                const titleNumber = titleAtSeason(driverChampions, champion, "name");
                const stats = driverSeasonStats[champion.year];
                const hasArticle = articleYears.has(champion.year);
                const CardTag = hasArticle ? "a" : "article";
                return (
                  <CardTag
                    class:list={["champion-card", { "is-linked": hasArticle }]}
                    style={`--team:${teamColours[champion.teamKey]}`}
                    href={hasArticle ? articlePath(champion.year) : undefined}
                    tabindex={hasArticle ? undefined : "0"}
                    aria-label={`${champion.name}, ${champion.year}${hasArticle ? `. ${copy.readArticle}` : ""}`}
                  >
                    <div class="card-flipper">
                      <div class="card-face card-front">
                        <div class="card-year">{champion.year}{hasArticle && <span aria-hidden="true">↗</span>}</div>
                        <div class="racing-number" aria-label={`${copy.carNumber}: ${champion.number === "—" ? copy.varied : champion.number}`}>
                          {champion.number}
                        </div>
                        <div class="card-copy">
                          <h3>{champion.name}</h3>
                          <p class="team-name">
                            <span class:list={["driver-team-logo", `driver-team-logo--${champion.teamKey}`]} aria-hidden="true">
                              <img src={teamLogos[champion.teamKey]} alt="" width="32" height="32" loading="lazy" decoding="async" />
                            </span>
                            {champion.team}
                          </p>
                          <p class="car-model"><small>{copy.car}</small>{championCarModels[champion.year]}</p>
                        </div>
                        <div class="flip-hint" aria-hidden="true">↻ {copy.flipHint}</div>
                        <div class="title-count">
                          <span class="ordinal-number">{titleNumber}<sup>{ordinalSuffix(titleNumber)}</sup></span>
                          <span class="title-word">{copy.title}</span>
                        </div>
                      </div>
                      <div class="card-face card-back">
                        <div class="card-year">{champion.year}</div>
                        <p class="stats-kicker">{copy.seasonStats}</p>
                        <h3>{champion.name}</h3>
                        <div class="driver-stat-grid">
                          <p><strong>{stats.wins}</strong><span>{copy.wins}</span></p>
                          <p><strong>{stats.podiums}</strong><span>{copy.podiums}</span></p>
                          <p><strong>{stats.poles}</strong><span>{copy.poles}</span></p>
                          <p><strong>{stats.dnfs}</strong><span>{copy.dnfs}</span></p>
                          <p class="points-stat"><strong>{stats.points}</strong><span>{copy.points}</span></p>
                        </div>
                      </div>
                    </div>
                  </CardTag>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="archive-panel" id="constructors-panel" role="tabpanel" aria-labelledby="constructors-tab" data-panel="constructors" hidden>
      <div class="panel-heading">
        <div>
          <p class="panel-kicker">{copy.latest} · 2025</p>
          <h2>{copy.constructorTab}</h2>
        </div>
        <div class="panel-stats">
          <p><strong>{constructorChampions.length}</strong><span>{copy.constructorSeasons}</span></p>
          <p><strong>{uniqueConstructors}</strong><span>{copy.constructorsCount}</span></p>
        </div>
      </div>

      <p class="history-note"><span aria-hidden="true">★</span>{copy.constructorNote}</p>

      <section class="leaderboard" aria-labelledby="constructor-leaders-title">
        <header class="leaderboard-heading">
          <p>{copy.allTime}</p>
          <h3 id="constructor-leaders-title">{copy.constructorLeaders}</h3>
        </header>
        <div class="leader-grid">
          {constructorLeaders.map((leader, index) => (
            <article
              class:list={["leader-card", { "is-record-holder": index === 0 }]}
              style={`--team:${teamColours[leader.teamKey]};--score:${(leader.titles / constructorLeaders[0].titles) * 100}%`}
            >
              <span class="leader-rank">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h4>{leader.name}</h4>
                <p><strong>{leader.titles}</strong> {copy.titles} <span>({leader.lastYear})</span></p>
              </div>
              <i aria-hidden="true"></i>
            </article>
          ))}
        </div>
      </section>

      <div class="timeline constructor-timeline">
        {constructorDecades.map(([decade, entries]) => (
          <section class="decade-block" aria-labelledby={`constructors-${decade}`}>
            <div class="decade-label">
              <span id={`constructors-${decade}`}>{decade}s</span>
              <i></i>
            </div>
            <div class="champion-grid constructor-grid">
              {entries.map((champion) => {
                const titleNumber = titleAtSeason(constructorChampions, champion, "team");
                const stats = constructorSeasonStats[champion.year];
                const hasArticle = articleYears.has(champion.year);
                const CardTag = hasArticle ? "a" : "article";
                return (
                  <CardTag
                    class:list={["champion-card", "constructor-card", { "is-linked": hasArticle }]}
                    style={`--team:${teamColours[champion.teamKey]}`}
                    href={hasArticle ? articlePath(champion.year) : undefined}
                    tabindex={hasArticle ? undefined : "0"}
                    aria-label={`${stats.constructorName}, ${champion.year}${hasArticle ? `. ${copy.readArticle}` : ""}`}
                  >
                    <div class="card-flipper">
                      <div class="card-face card-front">
                        <div class="card-year">{champion.year}{hasArticle && <span aria-hidden="true">↗</span>}</div>
                        <div class:list={["constructor-logo", `constructor-logo--${champion.teamKey}`]} aria-hidden="true">
                          <img
                            src={teamLogos[champion.teamKey]}
                            alt=""
                            width="96"
                            height="96"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        <div class="card-copy">
                          <h3 class:list={{ "is-long-name": stats.constructorName.length > 16, "is-extra-long-name": stats.constructorName.length > 21 }}>{stats.constructorName}</h3>
                          <p class="car-model"><small>{copy.car}</small>{constructorCarModels[champion.year]}</p>
                        </div>
                        <div class="flip-hint" aria-hidden="true">↻ {copy.flipHint}</div>
                        <div class="title-count">
                          <span class="ordinal-number">{titleNumber}<sup>{ordinalSuffix(titleNumber)}</sup></span>
                          <span class="title-word">{copy.title}</span>
                        </div>
                      </div>
                      <div class="card-face card-back constructor-back">
                        <div class="card-year">{champion.year}</div>
                        <div class="constructor-stats-title">
                          <p class="stats-kicker">{copy.seasonStats}</p>
                          <h3 class:list={{ "is-long-name": stats.constructorName.length > 16, "is-extra-long-name": stats.constructorName.length > 21 }}>{stats.constructorName}</h3>
                        </div>
                        <div class="constructor-stat-table">
                          <div class="constructor-stat-row stat-header" aria-hidden="true">
                            <span>{copy.driver}</span><span>W</span><span>PD</span><span>P</span><span>D</span><span>WCC</span>
                          </div>
                          {stats.drivers.slice(0, 5).map((driver) => (
                            <div class="constructor-stat-row">
                              <span title={driver.name}>{driver.name}</span>
                              <strong>{driver.wins}</strong>
                              <strong>{driver.podiums}</strong>
                              <strong>{driver.poles}</strong>
                              <strong>{driver.dnfs}</strong>
                              <strong>{driver.points}</strong>
                            </div>
                          ))}
                          {stats.drivers.length > 5 && (
                            <div class="constructor-stat-row stat-more">
                              <span>+{stats.drivers.length - 5} {isEl ? "ακόμη" : "more"}</span>
                            </div>
                          )}
                          <div class="constructor-stat-row stat-total">
                            <span>{copy.total}</span>
                            <strong>{stats.total.wins}</strong>
                            <strong>{stats.total.podiums}</strong>
                            <strong>{stats.total.poles}</strong>
                            <strong>{stats.total.dnfs}</strong>
                            <strong>{stats.total.points}</strong>
                          </div>
                        </div>
                        <div class="stat-legend"><span>W {copy.wins}</span><span>PD {copy.podiums}</span><span>P {copy.poles}</span><span>D {copy.dnfs}</span><span title={copy.constructorPoints}>WCC</span></div>
                      </div>
                    </div>
                  </CardTag>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </section>
  </div>

  <footer class="sources">
    <p><strong>{copy.source}</strong> · <a href="https://www.formula1.com/en/drivers/hall-of-fame" target="_blank" rel="noreferrer">Formula 1 Hall of Fame</a> · <a href="https://www.formula1.com/en/results/2025/drivers" target="_blank" rel="noreferrer">Formula 1 results</a> · <a href="https://github.com/TracingInsights/RaceData" target="_blank" rel="noreferrer">RaceData archive</a> · <a href="https://www.formula1-dictionary.net/f1-driver-constructor-championship/" target="_blank" rel="noreferrer">F1 Dictionary</a></p>
  </footer>
</main>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));

  const activate = (view: string, updateUrl = true) => {
    buttons.forEach((button) => {
      const active = button.dataset.view === view;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-selected", String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => panel.hidden = panel.dataset.panel !== view);

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (view === "constructors") url.searchParams.set("view", view);
      else url.searchParams.delete("view");
      history.replaceState({}, "", url);
    }
  };

  buttons.forEach((button, index) => {
    button.addEventListener("click", () => activate(button.dataset.view ?? "drivers"));
    button.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const next = event.key === "ArrowRight" ? (index + 1) % buttons.length : (index - 1 + buttons.length) % buttons.length;
      buttons[next].focus();
      activate(buttons[next].dataset.view ?? "drivers");
    });
  });

  const initialView = new URLSearchParams(window.location.search).get("view");
  if (initialView === "constructors") activate(initialView, false);
</script>

<style>
  .champions-page {
    --ink: #0c0b0a;
    --muted: #403c36;
    --soft: #5f5951;
    --surface: #fff;
    --surface-alt: #e9e2d7;
    --line: rgba(18, 15, 12, .27);
    --wash: rgba(18, 15, 12, .075);
    --switch-bg: rgba(255, 255, 255, .94);
    --shadow: rgba(39, 28, 21, .2);
    --card-shadow: 0 .45rem 1.15rem rgba(39, 28, 21, .1);
    --track: rgba(18, 15, 12, .17);
    --track-soft: rgba(18, 15, 12, .1);
    --on-accent: #fff;
    position: relative;
    min-height: 100vh;
    overflow: clip;
    color: var(--ink);
    background:
      radial-gradient(circle at 83% 5%, rgba(225, 6, 0, .11), transparent 25rem),
      #eee8dd;
    font-family: "Avenir Next", "Helvetica Neue", sans-serif;
  }

  :global(.dark) .champions-page {
    --ink: #f4f1e8;
    --muted: #a8a59d;
    --soft: #777771;
    --surface: #111214;
    --surface-alt: #0e0f11;
    --line: rgba(255, 255, 255, .12);
    --wash: rgba(255, 255, 255, .035);
    --switch-bg: rgba(9, 10, 11, .92);
    --shadow: rgba(0, 0, 0, .35);
    --card-shadow: 0 .65rem 1.5rem transparent;
    --track: rgba(255, 255, 255, .1);
    --track-soft: rgba(255, 255, 255, .06);
    background:
      radial-gradient(circle at 83% 5%, rgba(225, 6, 0, .2), transparent 24rem),
      #090a0b;
  }

  .track-lines {
    position: absolute;
    inset: 0 0 auto;
    height: 42rem;
    pointer-events: none;
    opacity: .24;
    background-image:
      linear-gradient(115deg, transparent 0 56%, var(--track) 56% 56.15%, transparent 56.15%),
      linear-gradient(115deg, transparent 0 61%, var(--track-soft) 61% 61.15%, transparent 61.15%);
  }

  .champions-hero, .archive-shell, .sources {
    position: relative;
    width: min(1240px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .champions-hero { padding: 2.25rem 0 4.5rem; }
  .back-link { color: var(--muted); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; transition: color .2s; }
  .back-link:hover { color: var(--ink); }
