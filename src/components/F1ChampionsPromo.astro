---
interface Props { lang?: "en" | "el" }
const { lang = "en" } = Astro.props;
const isEl = lang === "el";
---

<a class="champions-promo" href={isEl ? "/el/formula/champions" : "/formula/champions"}>
  <div class="promo-copy">
    <p>{isEl ? "ΔΙΑΔΡΑΣΤΙΚΟ ΑΡΧΕΙΟ · 1950—2025" : "INTERACTIVE ARCHIVE · 1950—2025"}</p>
    <h2>{isEl ? "Η αίθουσα των πρωταθλητών" : "The Hall of Champions"}</h2>
    <span>{isEl ? "Όλοι οι πρωταθλητές οδηγών και κατασκευαστών" : "Every Drivers’ and Constructors’ World Champion"}</span>
  </div>
  <div class="promo-count" aria-hidden="true">
    <strong>76</strong>
    <span>{isEl ? "ΣΕΖΟΝ" : "SEASONS"}</span>
  </div>
  <div class="promo-action">
    <span>{isEl ? "Άνοιγμα αρχείου" : "Explore the archive"}</span>
    <b>↗</b>
  </div>
</a>

<style>
  .champions-promo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 2.2rem;
    align-items: center;
    min-height: 12rem;
    margin-bottom: 3rem;
    padding: 2rem 2.2rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: .25rem 2rem .25rem .25rem;
    color: #f6f2e8;
    background: #0b0c0e;
    box-shadow: 0 1.3rem 3rem rgba(0,0,0,.16);
    text-decoration: none;
    isolation: isolate;
  }
  .champions-promo::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(105deg, transparent 0 62%, rgba(225,6,0,.35) 62% 72%, transparent 72%),
      repeating-linear-gradient(135deg, rgba(255,255,255,.035) 0 1px, transparent 1px 13px);
  }
  .champions-promo::after { content: ""; position: absolute; inset: 0 auto 0 0; width: .35rem; background: #e10600; }
  .promo-copy p { margin: 0 0 .7rem; color: #ff332b; font-size: .62rem; font-weight: 900; letter-spacing: .17em; }
  .promo-copy h2 { margin: 0; font-family: "Arial Narrow", "Avenir Next Condensed", sans-serif; font-size: clamp(1.9rem, 4vw, 3.25rem); font-style: italic; font-weight: 900; letter-spacing: -.045em; line-height: .95; text-transform: uppercase; }
  .promo-copy > span { display: block; margin-top: .75rem; color: #aaa79f; font-size: .78rem; }
  .promo-count { display: flex; flex-direction: column; align-items: center; padding: .7rem 1.5rem; border-inline: 1px solid rgba(255,255,255,.15); }
  .promo-count strong { font-family: "Arial Narrow", "Avenir Next Condensed", sans-serif; font-size: 3.8rem; font-style: italic; font-weight: 900; line-height: .8; }
  .promo-count span { margin-top: .65rem; color: #8d8b85; font-size: .55rem; font-weight: 900; letter-spacing: .15em; }
  .promo-action { display: flex; gap: 1rem; align-items: center; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .promo-action b { display: grid; width: 2.7rem; aspect-ratio: 1; place-content: center; border-radius: 50%; color: #0b0c0e; background: #f6f2e8; font-size: 1.1rem; transition: transform .2s, background .2s; }
  .champions-promo:hover .promo-action b { background: #ff332b; transform: rotate(45deg); }
  @media (max-width: 720px) {
    .champions-promo { grid-template-columns: 1fr auto; padding: 1.6rem; border-radius: .25rem 1.3rem .25rem .25rem; }
    .promo-count { display: none; }
    .promo-action span { display: none; }
  }
</style>
