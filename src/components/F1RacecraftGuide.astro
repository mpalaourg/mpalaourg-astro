  neutralTitle: "VSC, Safety Car and restarts",
  vsc: "Virtual Safety Car. It keeps the race running safely after an incident without sending a physical car onto the track. Drivers slow immediately and follow a set pace, so the gaps between them generally remain. Overtaking is forbidden. Race Control can end the VSC anywhere on the circuit; a physical Safety Car must return to the pits first.",
  safety: "A vehicle sent out for an accident, another hazard or extreme weather. Drivers slow down and queue behind it at reduced speed, with no overtaking. It leads the field until the track is safe, then returns to the pits at the end of a lap before normal racing speed resumes.",
  restart: "After a red flag, Race Control can choose a standing restart: the cars return to the grid and the lights go out again. If conditions make that unsuitable, they can use a rolling restart behind the Safety Car. An ordinary Safety Car withdrawal does not send the field back to the grid.",
  extraFormation: "If another formation lap is needed before the start, the scheduled race loses one lap for each extra formation lap. The cars have already burned fuel covering it.",
  penalties: "Stewards judge track limits and incidents. A qualifying lap can be deleted; a race infringement can bring a time penalty or a drive-through.",
  apexTitle: "Entry, apex, exit",
  apexIntro: "The apex is the point on the racing line closest to the inside of a corner. A driver will usually begin wide, approach the apex, then let the car run wide on exit. The exact line depends on the next corner and the track conditions.",
  apexLabels: ["ENTRY", "APEX", "EXIT"],
  apexCaption: "Schematic overhead view of a right-hand corner · compare the red reference line with the selected variation.",
  trajectoryPrompt: "Compare the paths",
  trajectoryLegend: "Solid red: reference line · dashed blue: selected variation",
  trajectories: [
    ["reference", "Racing line", "Enter from the outside, pass close to the inside apex, then let the car open out on exit."],
    ["late", "Late apex", "Turn in later and reach the inside farther around the corner, leaving a straighter exit."],
    ["understeer", "Understeer", "The front does not turn as much as the driver asks, so the path runs wide toward the outside."],
    ["oversteer", "Oversteer", "The rear slides and the car rotates more than intended. The dashed path shows one possible move toward the inside; the real path depends on the driver's correction."],
  ],
  lineTerms: [
    ["Late apex", "A later clipping point often trades some entry speed for a better launch out of the corner."],
    ["Understeer", "The front does not turn as much as the driver asks, so the car runs wide."],
    ["Oversteer", "The rear loses grip and rotates more than expected."],
    ["Outbrake", "An attempt to brake later than another driver to make a pass. Brake too early and you lose time; too late and you may carry too much speed into the corner, run wide or lock a wheel under heavy braking."],
  ],
  strategyTitle: "Undercut or overcut?",
  strategyIntro: "A place can change hands in the pits. The question is who stops first, and how fast the other driver can go while they wait.",
  undercut: "The chasing driver pits first. On fresh tyres, they try to set a fast enough lap to emerge ahead when their rival stops.",
  overcut: "The chasing driver stays out when their rival pits. If their own lap is quick, or the rival loses time on cold tyres or in traffic, they can emerge ahead after stopping later.",
  diagram: { leader: "AHEAD", chaser: "BEHIND", pit: "PIT", track: "TRACK", fresh: "FRESH", laps: ["LAP 18", "LAP 19", "LAP 20", "LAP 21"] },
  strategyNote: "The gain depends on tyre wear, time lost in the pit lane, traffic and how quickly new tyres warm up. Neither move guarantees a pass.",
  newTitle: "The 2026 terms worth knowing",
  newIntro: "DRS is gone. The 2026 cars have movable wing elements and more electric power, so the radio and commentary now use these terms:",
  newTerms: [
    ["Active aero", "Front and rear wings switch between corner and lower-drag straight settings in permitted sections."],
    ["Overtake Mode", "Extra electrical energy for a driver close enough to the car ahead at the detection point."],
    ["Boost & recharge", "The driver chooses when to deploy available electrical energy; the car recovers it mainly under braking."],
  ],
  moreTermsTitle: "Three more terms you will hear",
  moreTerms: [
    ["MGU-K", "Motor Generator Unit – Kinetic. It recovers energy mainly under braking and uses it to add electric power. From 2026 it can deliver 350 kW, nearly three times its previous output, and can recover energy while coasting or even on throttle."],
    ["MGU-H", "Motor Generator Unit – Heat. It recovered energy from the engine’s exhaust gases for use elsewhere in the hybrid system. It was removed from F1 power units for 2026."],
    ["Super Licence", "The FIA qualification a driver needs to race in F1. Normally, a new driver must be at least 18 and earn 40 points in other series: an F2 title earns 40, an F3 title 30. The FIA may exceptionally approve a 17-year-old."],
  ],
  allocationsTitle: "How many parts can a driver use?",
  allocationsIntro: "For 2026, each driver has a season-long allowance for the main power-unit elements. These totals already include the extra unit permitted for the first year of the new rules.",
  allocations: [
    ["ICE", "Combustion engines", "4"],
    ["TC", "Turbochargers", "4"],
    ["EXH", "Exhaust sets", "4"],
    ["MGU-K", "Motor-generator units", "3"],
    ["ES", "Energy stores", "3"],
    ["CE", "Control electronics", "3"],
  ],
  allocationsPenalty: "The first extra unit of each type costs 10 grid places; further extras of the same type cost five each. Penalties add together. Once a driver's unserved grid penalties exceed 15 places, they start behind the other classified drivers.",
};

const navIds = ["weekend", "tyres", "flags", "corner", "strategy", "new-2026"];
---

<article class="field-guide">
  <header class="guide-hero">
    <div class="hero-inner">
      <a class="back-link" href={isEl ? "/el/formula" : "/formula"}>← {copy.back}</a>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <p class="hero-note">{copy.note}</p>
      <div class="hero-turn" aria-hidden="true"><span>01</span><svg viewBox="0 0 330 210"><path d="M-15 44 H128 Q262 44 262 170 V225" fill="none" stroke="currentColor" stroke-width="22"/><path d="M-15 44 H128 Q262 44 262 170 V225" fill="none" stroke="#f6efe4" stroke-width="2" stroke-dasharray="12 12"/></svg><span>02</span></div>
    </div>
  </header>

  <nav class="guide-contents" aria-label={isEl ? "Περιεχόμενα άρθρου" : "Article contents"}>
    <div>{copy.nav.map((label, index) => <a href={`#${navIds[index]}`}><span>{String(index + 1).padStart(2, "0")}</span>{label}</a>)}</div>
  </nav>

  <div class="guide-body">
    <p class="chapter">{copy.chapters[0]}</p>
    <section id="weekend" class="guide-section">
      <div class="section-head"><h2>{copy.weekendTitle}</h2><p>{copy.weekendIntro}</p></div>
      <div class="weekend-grid">
        {copy.weekend.map(([day, title, description], index) => <div class="weekend-card"><span class="card-index">0{index + 1} / {day}</span><h3>{title}</h3><p>{description}</p></div>)}
      </div>
      <aside class="sprint-note"><strong>SPRINT ↗</strong><p>{copy.sprint}</p></aside>
      <div class="race-facts">{copy.raceFacts.map(([title, description]) => <div><strong>{title}</strong><p>{description}</p></div>)}</div>
    </section>

    <section id="tyres" class="guide-section split-section">
      <div class="section-head"><h2>{copy.tyresTitle}</h2><p>{copy.tyresIntro}</p></div>
      <div class="tyre-panel">
        <div class="compound-range" aria-label={copy.tyreRange}><span>C1</span><span>C2</span><span>C3</span><span>C4</span><span>C5</span><span class="historical-compound">C6<small>2025</small></span></div>
        <p class="range-note">{copy.tyreRange}</p>
        <div class="tyre-grid">
          {copy.tyres.map(([code, name, description], index) => <div class="tyre-item"><span class={`tyre tyre-${index}`} aria-hidden="true"><i></i></span><span class="tyre-code">{code}</span><h3>{name}</h3><p>{description}</p></div>)}
        </div>
        <div class="selection-map" role="img" aria-label={copy.tyreExample}>
          <div><small>{isEl ? "ΠΑΡΑΔΕΙΓΜΑ Α" : "EXAMPLE A"}</small><span class="selected-hard">C1</span><span class="selected-medium">C2</span><span class="selected-soft">C3</span></div>
          <div><small>{isEl ? "ΠΑΡΑΔΕΙΓΜΑ Β" : "EXAMPLE B"}</small><span class="selected-hard">C3</span><span class="selected-medium">C4</span><span class="selected-soft">C5</span></div>
        </div>
        <p class="example-note">{copy.tyreExample}</p>
        <div class="wet-tyres">
          {copy.wetTyres.map(([code, name, description], index) => <div class="tyre-item wet-tyre-item"><span class={`tyre tyre-${index + 3}`} aria-hidden="true"><i></i></span><span class="tyre-code">{code}</span><h3>{name}</h3><p>{description}</p></div>)}
        </div>
      </div>
      <p class="rule-note"><span>↳</span>{copy.tyreRule}</p>
    </section>

    <section id="flags" class="guide-section flags-section">
      <div class="section-head"><h2>{copy.flagsTitle}</h2></div>
      <div class="flag-list">
        {copy.flags.map(([name, description], index) => <div class={`flag-row ${index === 2 ? "flag-row-double" : ""}`}>
          {index === 2 ? <span class="double-flag" aria-hidden="true"><span class="flag flag-2"></span><span class="flag flag-2"></span></span> : <span class={`flag flag-${index}`} aria-hidden="true"></span>}
          <h3>{name}</h3><p>{description}</p>
        </div>)}
      </div>
      <div class="race-control">
        <h3>{copy.neutralTitle}</h3>
        <div class="control-grid"><div><span>01 / VSC</span><p>{copy.vsc}</p></div><div><span>02 / SC</span><p>{copy.safety}</p></div></div>
        <div class="restart-notes"><p><strong>{isEl ? "ΕΠΑΝΕΚΚΙΝΗΣΗ" : "RESTART"}</strong>{copy.restart}</p><p><strong>{isEl ? "ΕΠΙΠΛΕΟΝ ΓΥΡΟΣ" : "EXTRA LAP"}</strong>{copy.extraFormation}</p></div>
      </div>
      <p class="penalty-note"><strong>↯</strong> {copy.penalties}</p>
    </section>

    <p class="chapter">{copy.chapters[1]}</p>
    <section id="corner" class="guide-section corner-section">
      <div class="section-head"><h2>{copy.apexTitle}</h2><p>{copy.apexIntro}</p></div>
      <div class="trajectory-explorer">
      <fieldset class="trajectory-controls"><legend>{copy.trajectoryPrompt}</legend><div>
        {copy.trajectories.map(([mode, label], index) => <label><input type="radio" name={`trajectory-${lang}`} value={mode} checked={index === 0} /><span>{label}</span></label>)}
      </div></fieldset>
      <figure class="apex-figure">
        <svg viewBox="0 0 760 430" role="img" aria-label={copy.apexCaption}>
          <defs><pattern id="asphalt-grain" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="4" cy="6" r=".6" fill="#fff" opacity=".15"/><circle cx="13" cy="14" r=".6" fill="#fff" opacity=".12"/></pattern></defs>
          <path d="M0 50 H340 Q620 50 620 330 V430 H470 V330 Q470 200 340 200 H0 Z" fill="#292a29"/>
          <path d="M0 50 H340 Q620 50 620 330 V430 H470 V330 Q470 200 340 200 H0 Z" fill="url(#asphalt-grain)"/>
          <path d="M0 50 H340 Q620 50 620 330 V430 M0 200 H340 Q470 200 470 330 V430" fill="none" stroke="#e7ded0" stroke-width="5"/>
          <path d="M0 125 H340 Q545 125 545 330 V430" fill="none" stroke="#b6b0a7" stroke-width="2" stroke-dasharray="8 13"/>
          <path d="M40 82 C250 82 520 220 580 385" fill="none" stroke="#f2443b" stroke-width="6" stroke-linecap="round"/>
          <path class="trajectory-alt trajectory-late" d="M40 78 C340 78 480 190 520 385" aria-hidden="true"/>
          <path class="trajectory-alt trajectory-understeer" d="M366 172 C480 170 635 175 600 365" aria-hidden="true"/>
          <path class="trajectory-alt trajectory-oversteer" d="M451 226 C465 245 535 275 515 385" aria-hidden="true"/>
          <circle cx="451" cy="226" r="7" fill="#f2443b" stroke="#fff" stroke-width="2"/>
          <circle class="trajectory-alt trajectory-late trajectory-point" cx="466" cy="248" r="6" aria-hidden="true"/>
          <g class="apex-leader-halos" fill="none" stroke-width="5"><line x1="130" y1="82" x2="130" y2="245"/><line x1="451" y1="226" x2="350" y2="312"/><line x1="580" y1="350" x2="635" y2="350"/></g>
          <g class="apex-leaders" fill="none" stroke-width="2"><line x1="130" y1="82" x2="130" y2="245"/><line x1="451" y1="226" x2="350" y2="312"/><line x1="580" y1="350" x2="635" y2="350"/></g>
          <text x="55" y="270">01 · {copy.apexLabels[0]}</text><text x="270" y="340">02 · {copy.apexLabels[1]}</text><text x="635" y="330">03 · {copy.apexLabels[2]}</text>
        </svg>
        <figcaption>{copy.apexCaption}</figcaption>
      </figure>
      <p class="trajectory-legend">{copy.trajectoryLegend}</p>
      <div class="trajectory-readout" aria-live="polite">{copy.trajectories.map(([mode, label, description]) => <p data-mode={mode}><strong>{label}.</strong> {description}</p>)}</div>
      </div>
      <div class="terms-grid">{copy.lineTerms.map(([term, description]) => <div><h3>{term}</h3><p>{description}</p></div>)}</div>
    </section>

    <p class="chapter">{copy.chapters[2]}</p>
    <section id="strategy" class="guide-section strategy-section">
      <div class="section-head"><h2>{copy.strategyTitle}</h2><p>{copy.strategyIntro}</p></div>
      <div class="strategy-grid">
        <div class="strategy-card"><div class="strategy-heading"><span>01</span><h3>Undercut</h3></div><p>{copy.undercut}</p><div class="lap-diagram" role="img" aria-label={isEl ? "Undercut: ο οδηγός πίσω σταματά στον γύρο 19, ο οδηγός μπροστά στον γύρο 20" : "Undercut: the chasing driver pits on lap 19, the leader on lap 20"}>
          <div class="lap-head"><span></span>{copy.diagram.laps.map(lap => <span>{lap}</span>)}</div>
          <div class="lap-row"><b>{copy.diagram.leader}</b><span>{copy.diagram.track}</span><span>{copy.diagram.track}</span><span class="pit-cell">{copy.diagram.pit}</span><span class="fresh-cell">{copy.diagram.fresh}</span></div>
          <div class="lap-row"><b>{copy.diagram.chaser}</b><span>{copy.diagram.track}</span><span class="pit-cell">{copy.diagram.pit}</span><span class="fresh-cell">{copy.diagram.fresh}</span><span class="fresh-cell">{copy.diagram.fresh}</span></div>
        </div></div>
        <div class="strategy-card"><div class="strategy-heading"><span>02</span><h3>Overcut</h3></div><p>{copy.overcut}</p><div class="lap-diagram" role="img" aria-label={isEl ? "Overcut: ο οδηγός μπροστά σταματά στον γύρο 19, ο οδηγός πίσω στον γύρο 21" : "Overcut: the leader pits on lap 19, the chasing driver on lap 21"}>
          <div class="lap-head"><span></span>{copy.diagram.laps.map(lap => <span>{lap}</span>)}</div>
          <div class="lap-row"><b>{copy.diagram.leader}</b><span>{copy.diagram.track}</span><span class="pit-cell">{copy.diagram.pit}</span><span class="fresh-cell">{copy.diagram.fresh}</span><span class="fresh-cell">{copy.diagram.fresh}</span></div>
          <div class="lap-row"><b>{copy.diagram.chaser}</b><span>{copy.diagram.track}</span><span>{copy.diagram.track}</span><span>{copy.diagram.track}</span><span class="pit-cell">{copy.diagram.pit}</span></div>
        </div></div>
      </div>
      <p class="strategy-footnote">{copy.strategyNote}</p>
    </section>

    <p class="chapter">{copy.chapters[3]}</p>
    <section id="new-2026" class="guide-section new-section">
      <div class="section-head"><h2>{copy.newTitle}</h2><p>{copy.newIntro}</p></div>
      <div class="new-terms">{copy.newTerms.map(([term, description], index) => <div><span>0{index + 1}</span><h3>{term}</h3><p>{description}</p></div>)}</div>
      <div class="more-terms"><h3>{copy.moreTermsTitle}</h3><div class="new-terms">{copy.moreTerms.map(([term, description], index) => <div><span>0{index + 4}</span><h3>{term}</h3><p>{description}</p></div>)}</div></div>
      <div class="allocations"><div class="allocation-head"><h3>{copy.allocationsTitle}</h3><p>{copy.allocationsIntro}</p></div><div class="allocation-grid">{copy.allocations.map(([code, name, count]) => <div><strong>{count}</strong><span>{code}</span><p>{name}</p></div>)}</div><p class="allocation-penalty">{copy.allocationsPenalty}</p></div>
    </section>
  </div>
</article>

<style>
  .field-guide { --paper: #f7f5ef; --ink: #1b211d; --muted: #444d45; --line: #b9c0b6; --accent: #a8221b; --comparison: #126d8a; --panel: #fffefa; --hero-bg: #e8ebe4; --hero-ink: #172019; --hero-lead: #344037; --hero-note: #505b52; --hero-pattern: #1720190c; --callout: #e9eee7; --callout-ink: #202a23; --figure-bg: #e9ede7; --figure-caption: #414b42; --figure-leader: #485249; --diagram-cell: #dce3db; --diagram-ink: #1b211d; color: var(--ink); background: var(--paper); font-family: "Avenir Next", "Helvetica Neue", sans-serif; }
  :global(.dark) .field-guide { --paper: #111512; --ink: #f5f5ef; --muted: #d0d6cd; --line: #576158; --accent: #ff8a7d; --comparison: #8fd7ee; --panel: #1c231e; --hero-bg: #171b18; --hero-ink: #f8f5ed; --hero-lead: #e1e8de; --hero-note: #b5c0b3; --hero-pattern: #ffffff0b; --callout: #252e27; --callout-ink: #f1f4ec; --figure-bg: #202923; --figure-caption: #d0d9cd; --figure-leader: #f8f0e5; --diagram-cell: #303a32; --diagram-ink: #f1f4ec; }
  .guide-hero { position: relative; overflow: hidden; color: var(--hero-ink); background: var(--hero-bg); }
  .guide-hero::before { content: ""; position: absolute; inset: 0; opacity: .7; background: repeating-linear-gradient(132deg, transparent 0 23px, var(--hero-pattern) 24px, transparent 25px), radial-gradient(circle at 83% 18%, #d7241917, transparent 35%); pointer-events: none; }
  .hero-inner { position: relative; width: min(1180px, calc(100% - 2.5rem)); min-height: 36rem; margin: auto; padding: 2rem 0 5rem; }
  .back-link { color: var(--hero-lead); font-size: .8rem; font-weight: 800; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; }
  .back-link:hover { color: var(--accent); }
  .eyebrow, .chapter { color: var(--accent); font-size: .69rem; font-weight: 900; letter-spacing: .19em; text-transform: uppercase; }
  .eyebrow { margin: 6rem 0 1rem; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { position: relative; z-index: 1; margin-bottom: 2rem; font-family: "Arial Narrow", "Avenir Next Condensed", sans-serif; font-size: clamp(3.5rem, 7vw, 7rem); font-style: italic; font-weight: 900; letter-spacing: -.075em; line-height: .9; text-transform: uppercase; }
  .hero-lead { position: relative; z-index: 1; max-width: 54rem; margin-bottom: 1.5rem; color: var(--hero-lead); font-size: clamp(1.05rem, 1.8vw, 1.23rem); line-height: 1.6; }
  .hero-note { position: relative; z-index: 1; color: var(--hero-note); font-size: .8rem; letter-spacing: .04em; }
  .hero-turn { position: absolute; right: -2rem; bottom: 0; display: flex; align-items: center; width: 35%; height: 70%; opacity: .24; color: #c52b22; transform: rotate(-10deg); }
  .hero-turn svg { width: 100%; height: 100%; }
  .hero-turn span { position: absolute; left: 0; top: 25%; color: var(--hero-ink); font-size: .7rem; font-weight: 900; }
  .hero-turn span:last-child { left: auto; right: 0; top: 75%; }
  .guide-contents { position: sticky; top: 0; z-index: 30; overflow-x: auto; color: #fff9f3; background: #a51d16; box-shadow: 0 .3rem .8rem #0003; }
  .guide-contents > div { display: flex; width: min(1180px, calc(100% - 2.5rem)); min-width: max-content; margin: auto; }
  .guide-contents a { display: flex; gap: .55rem; align-items: center; min-height: 3.2rem; padding: 0 1.2rem; border-right: 1px solid #ffffff55; color: inherit; font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .guide-contents a:first-child { border-left: 1px solid #ffffff55; }
  .guide-contents a:hover, .guide-contents a:focus-visible { background: #74120e; }
  .guide-contents span { color: #fff2e6; font-size: .68rem; }
  .guide-body { width: min(1180px, calc(100% - 2.5rem)); margin: auto; padding: 5rem 0 6rem; }
  .chapter { margin: 1rem 0 1.2rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .guide-section { margin-bottom: 6rem; scroll-margin-top: 5rem; }
  .section-head { display: grid; gap: .85rem; margin-bottom: 2.2rem; }
  h2 { margin-bottom: 0; font-family: "Arial Narrow", "Avenir Next Condensed", sans-serif; font-size: clamp(2.55rem, 4.2vw, 4rem); font-style: italic; font-weight: 900; letter-spacing: -.055em; line-height: 1; text-transform: uppercase; }
  .section-head p { max-width: 65rem; margin: 0; color: var(--muted); font-size: 1.07rem; line-height: 1.65; }
  h3 { font-family: "Arial Narrow", "Avenir Next Condensed", sans-serif; font-size: 1.55rem; font-style: italic; font-weight: 900; letter-spacing: -.035em; text-transform: uppercase; }
  .weekend-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); background: var(--panel); }
  .weekend-card { min-height: 15rem; padding: 1.5rem; }
  .weekend-card + .weekend-card { border-left: 1px solid var(--line); }
  .card-index { color: var(--accent); font-size: .65rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .weekend-card h3 { margin: 3rem 0 .6rem; }
  .weekend-card p, .tyre-item p, .terms-grid p, .strategy-card p, .new-terms p { color: var(--muted); font-size: .98rem; line-height: 1.6; }
  .sprint-note { display: flex; gap: 1.5rem; align-items: baseline; margin-top: .8rem; padding: 1.1rem 1.5rem; border-left: 4px solid var(--accent); color: var(--callout-ink); background: var(--callout); }
  .sprint-note strong { flex: 0 0 auto; color: var(--accent); font-size: .8rem; letter-spacing: .1em; }
  .sprint-note p { margin: 0; font-size: .96rem; line-height: 1.6; }
  .race-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .race-facts > div { padding: 1.25rem; border-top: 3px solid var(--accent); background: var(--panel); }
  .race-facts strong { display: block; margin-bottom: .75rem; color: var(--accent); font-size: .75rem; letter-spacing: .12em; }
  .race-facts p { margin: 0; color: var(--muted); font-size: .96rem; line-height: 1.6; }
  .tyre-panel { padding: 2rem; border: 1px solid var(--line); background: var(--panel); }
  .compound-range { display: grid; grid-template-columns: repeat(6, 1fr); gap: .3rem; max-width: 42rem; }
  .compound-range span { padding: .75rem .2rem; border: 1px solid var(--line); color: var(--ink); background: #eef1eb; font-family: "Arial Narrow", "Avenir Next Condensed", sans-serif; font-size: 1.2rem; font-style: italic; font-weight: 900; text-align: center; }
