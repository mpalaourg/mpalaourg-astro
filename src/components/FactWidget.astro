---
interface Props {
  lang?: "en" | "el";
  variant?: "compact" | "contained";
}

const { lang = "en", variant = "compact" } = Astro.props;

const t = {
  en: {
    title: "Did You Know?",
    newFact: "New Fact",
    general: "General",
    onThisDay: "On This Day",
    sports: "Sports",
    answer: "Answer",
    revealAnswer: "Reveal answer",
    hideAnswer: "Hide answer",
    translationNote: "",
  },
  el: {
    title: "Ξέρατε Ότι;",
    newFact: "Νέο Γεγονός",
    general: "Γενικά",
    onThisDay: "Σαν Σήμερα",
    sports: "Αθλητισμός",
    answer: "Απάντηση",
    revealAnswer: "Εμφάνιση απάντησης",
    hideAnswer: "Απόκρυψη απάντησης",
    translationNote: "Αυτόματη μετάφραση. Ενδέχονται λάθη.",
  },
} as const;

const T = t[lang];
---

<div class="fact-widget group relative" data-lang={lang} data-category="general" data-variant={variant} data-reveal-answer={T.revealAnswer} data-hide-answer={T.hideAnswer}>
  {variant === "compact" ? (
    <>
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-gradient-to-r from-yellow-500/10 via-orange-400/10 to-amber-400/10 border border-yellow-200/50 dark:border-yellow-700/50 hover:border-yellow-400 dark:hover:border-yellow-500 transition-all cursor-pointer">
        <span class="text-base">💡</span>
        <span class="fact-preview text-xs font-medium text-gray-600 dark:text-slate-400 truncate max-w-[120px]">{lang === "el" ? "Φόρτωση..." : "Loading..."}</span>
      </div>

      <div class="fact-popup absolute top-full left-0 mt-2 w-80 p-4 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-gray-700 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-xl">💡</span>
            <div class="font-bold text-sm">{T.title}</div>
          </div>
          <button class="fact-refresh text-xs text-yellow-600 dark:text-yellow-400 hover:underline cursor-pointer flex items-center gap-1">
            🔄 {T.newFact}
          </button>
        </div>

        <div class="flex gap-2 mb-3">
          <button class="fact-category-general flex-1 py-1.5 px-2 text-xs font-medium rounded-lg bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-700 transition-colors active-category">
            {T.general}
          </button>
          <button class="fact-category-otd flex-1 py-1.5 px-2 text-xs font-medium rounded-lg bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-600 transition-colors">
            {T.onThisDay}
          </button>
          <button class="fact-category-sports flex-1 py-1.5 px-2 text-xs font-medium rounded-lg bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-600 transition-colors">
            {T.sports}
          </button>
        </div>

        <div class="fact-content text-sm text-gray-700 dark:text-slate-300 leading-relaxed min-h-[60px]">
          {lang === "el" ? "Φόρτωση πληροφορίας..." : "Loading interesting fact..."}
        </div>

        <div class="fact-source text-[10px] text-gray-400 mt-2 text-right">--</div>
        <div class="fact-translation-note text-[10px] text-gray-400 mt-1 text-right italic hidden">{T.translationNote}</div>
      </div>
    </>
  ) : (
    <div class="h-full rounded-3xl border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-yellow-600 dark:text-yellow-400">{T.title}</div>
        <button class="fact-refresh text-sm font-medium text-yellow-700 dark:text-yellow-400 hover:underline">
          {T.newFact}
        </button>
      </div>

      <div class="flex flex-wrap gap-2 mb-4">
        <button class="fact-category-general px-3 py-1.5 text-xs font-medium rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-700 transition-colors active-category">
          {T.general}
        </button>
        <button class="fact-category-otd px-3 py-1.5 text-xs font-medium rounded-full bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-600 transition-colors">
          {T.onThisDay}
        </button>
        <button class="fact-category-sports px-3 py-1.5 text-xs font-medium rounded-full bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400 border border-gray-200 dark:border-slate-600 transition-colors">
          {T.sports}
        </button>
      </div>

      <div class="fact-preview hidden">{lang === "el" ? "Φόρτωση..." : "Loading..."}</div>
      <div class="fact-content text-sm text-gray-700 dark:text-slate-300 leading-7 min-h-[96px]">
        {lang === "el" ? "Φόρτωση πληροφορίας..." : "Loading interesting fact..."}
      </div>

      <div class="fact-source break-words text-xs text-gray-400 dark:text-slate-500 mt-4">--</div>
      <div class="fact-translation-note text-[10px] text-gray-400 dark:text-slate-500 mt-2 italic hidden">{T.translationNote}</div>
    </div>
  )}
</div>

<style>
  .fact-widget {
    position: relative;
  }
  .active-category {
    ring-width: 2px;
    ring-color: rgb(234 179 8);
  }
</style>

<script is:inline>
  const translationCache = new Map();

  function safeHttpUrl(value) {
    if (typeof value !== 'string') return null;
    try {
      const url = new URL(value);
      return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : null;
    } catch {
      return null;
    }
  }

  async function translateText(text, targetLang) {
    const cacheKey = `${text}_${targetLang}`;
    if (translationCache.has(cacheKey)) {
      return translationCache.get(cacheKey);
    }

    try {
      const encodedText = encodeURIComponent(text);
      const res = await fetch(`/api/translate?text=${encodedText}&target=${targetLang}`);
      if (res.ok) {
        const data = await res.json();
        if (data.success && data.text) {
          const result = { text: data.text, success: true, source: 'deepl' };
          translationCache.set(cacheKey, result);
          return result;
        }
      }
    } catch (e) {
      console.log('DeepL translation failed:', e);
    }

    try {
      const encodedText = encodeURIComponent(text);
      const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodedText}&langpair=en|${targetLang}`);
      if (res.ok) {
        const data = await res.json();
        if (data.responseStatus === 200 && data.responseData) {
          const result = { text: data.responseData.translatedText, success: true, source: 'mymemory' };
          translationCache.set(cacheKey, result);
          return result;
        }
      }
    } catch (e) {
      console.log('MyMemory translation failed:', e);
    }

    return { text: null, success: false, source: null };
  }

  async function fetchFact(widget, category) {
    const lang = widget.dataset.lang;

    const previewEl = widget.querySelector('.fact-preview');
    const contentEl = widget.querySelector('.fact-content');
    if (previewEl) previewEl.textContent = lang === 'el' ? 'Φόρτωση...' : 'Loading...';
    if (contentEl) contentEl.textContent = lang === 'el' ? 'Φόρτωση γεγονότος...' : 'Loading fact...';

    try {
      let endpoint = '';
      const skipCache = widget.dataset.skipCache === 'true';
      widget.dataset.skipCache = 'false';

      if (category === 'general') {
        endpoint = `/api/facts/general${skipCache ? '?nocache=true' : ''}`;
      } else if (category === 'otd') {
        endpoint = `/api/facts/onthisday?lang=${lang}${skipCache ? '&nocache=true' : ''}`;
      } else if (category === 'sports') {
        endpoint = `/api/facts/sports${skipCache ? '?nocache=true' : ''}`;
      }

      const separator = endpoint.includes('?') ? '&' : '?';
      const res = await fetch(`${endpoint}${separator}t=${Date.now()}`);
      if (!res.ok) throw new Error(`Failed to fetch: ${res.status}`);
      const data = await res.json();

      let factText = '';
      let needsTranslation = data.needsTranslation && lang === 'el';
      let isTranslated = false;

      if (category === 'sports') {
        let question = data.question;
        let answer = data.answer;

        if (needsTranslation) {
          const qTranslation = await translateText(question, 'el');
          if (qTranslation.success) {
            question = qTranslation.text;
            isTranslated = true;
          }
          const aTranslation = await translateText(answer, 'el');
          if (aTranslation.success) answer = aTranslation.text;
        }

        if (previewEl) previewEl.textContent = `${lang === 'el' ? 'Ερώτηση' : 'Question'}: ${question.substring(0, 30)}...`;
        if (contentEl) {
          const questionLabel = document.createElement('strong');
          questionLabel.textContent = `${lang === 'el' ? 'Ερώτηση' : 'Question'}: `;
          const answerRow = document.createElement('div');
          answerRow.className = 'mt-2 border-t border-gray-200 pt-2 dark:border-gray-700';
          const answerLabel = document.createElement('span');
          answerLabel.className = 'text-xs text-gray-500';
          answerLabel.textContent = `${lang === 'el' ? 'Απάντηση' : 'Answer'}: `;
          const revealButton = document.createElement('button');
          revealButton.type = 'button';
          revealButton.className = 'cursor-pointer rounded px-1 text-xs font-medium text-yellow-700 underline underline-offset-2 hover:text-yellow-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-600 dark:text-yellow-400 dark:hover:text-yellow-300';
          revealButton.textContent = widget.dataset.revealAnswer;
          revealButton.setAttribute('aria-expanded', 'false');
          const answerText = document.createElement('span');
          answerText.className = 'ml-1';
          answerText.id = `fact-answer-${Math.random().toString(36).slice(2)}`;
          answerText.textContent = String(answer ?? '');
          answerText.hidden = true;
          revealButton.setAttribute('aria-controls', answerText.id);
          revealButton.addEventListener('click', () => {
            answerText.hidden = !answerText.hidden;
            revealButton.setAttribute('aria-expanded', String(!answerText.hidden));
            revealButton.textContent = answerText.hidden ? widget.dataset.revealAnswer : widget.dataset.hideAnswer;
          });
          answerRow.append(answerLabel, revealButton, answerText);
          contentEl.replaceChildren(questionLabel, document.createTextNode(String(question ?? '')), answerRow);
        }
      } else {
        factText = data.fact;
        if (needsTranslation) {
          const translation = await translateText(factText, 'el');
          if (translation.success) {
            factText = translation.text;
            isTranslated = true;
          }
        }
        if (previewEl) previewEl.textContent = factText.substring(0, 30) + '...';
        if (contentEl) contentEl.textContent = factText;
      }

      const sourceEl = widget.querySelector('.fact-source');
      if (sourceEl) {
        const sourceUrl = safeHttpUrl(data.sourceUrl);
        if (data.source === 'fallback') {
          sourceEl.textContent = lang === 'el' ? 'Τυχαίο γεγονός' : 'Random fact';
        } else if (category === 'otd' && data.date) {
          const label = `${data.date} • ${data.source} →`;
          if (sourceUrl) {
            const link = document.createElement('a');
            link.href = sourceUrl;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'hover:underline';
            link.textContent = label;
            sourceEl.replaceChildren(link);
          } else sourceEl.textContent = label;
        } else if (sourceUrl) {
          const link = document.createElement('a');
          link.href = sourceUrl;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.className = 'hover:underline';
          link.textContent = `${lang === 'el' ? 'Πηγή' : 'Source'}: ${data.source} →`;
          sourceEl.replaceChildren(link);
        } else {
          sourceEl.textContent = `${lang === 'el' ? 'Πηγή' : 'Source'}: ${data.source}`;
        }
      }

      const translationNoteEl = widget.querySelector('.fact-translation-note');
      if (translationNoteEl) {
        translationNoteEl.classList.toggle('hidden', !(isTranslated && lang === 'el'));
      }
    } catch (err) {
      console.error('Fact fetch error:', err);
      const sourceEl = widget.querySelector('.fact-source');
      if (previewEl) previewEl.textContent = lang === 'el' ? 'Σφάλμα' : 'Error';
      if (contentEl) contentEl.textContent = lang === 'el' ? 'Αποτυχία φόρτωσης' : 'Failed to load';
      if (sourceEl) sourceEl.textContent = lang === 'el' ? 'Σφάλμα φόρτωσης' : 'Error loading';
    }
  }

  function updateCategoryButtons(widget, category) {
    const generalBtn = widget.querySelector('.fact-category-general');
    const otdBtn = widget.querySelector('.fact-category-otd');
    const sportsBtn = widget.querySelector('.fact-category-sports');
    [generalBtn, otdBtn, sportsBtn].forEach(btn => {
      btn?.classList.remove('bg-yellow-100', 'dark:bg-yellow-900/30', 'text-yellow-700', 'dark:text-yellow-300', 'border-yellow-200', 'dark:border-yellow-700');
      btn?.classList.add('bg-gray-100', 'dark:bg-slate-700', 'text-gray-600', 'dark:text-slate-400', 'border-gray-200', 'dark:border-slate-600');
    });

    const activeBtn = category === 'general' ? generalBtn : category === 'otd' ? otdBtn : sportsBtn;
    activeBtn?.classList.remove('bg-gray-100', 'dark:bg-slate-700', 'text-gray-600', 'dark:text-slate-400', 'border-gray-200', 'dark:border-slate-600');
    activeBtn?.classList.add('bg-yellow-100', 'dark:bg-yellow-900/30', 'text-yellow-700', 'dark:text-yellow-300', 'border-yellow-200', 'dark:border-yellow-700');
  }

  document.querySelectorAll('.fact-widget').forEach(widget => {
    const signalItem = widget.closest('[data-signal-item]');
    if (signalItem) {
      signalItem.addEventListener('playful-signal:open', () => {
        if (widget.dataset.initialized === 'true') return;
        widget.dataset.initialized = 'true';
        fetchFact(widget, 'general');
      });
    } else {
      fetchFact(widget, 'general');
    }

    const generalBtn = widget.querySelector('.fact-category-general');
    const otdBtn = widget.querySelector('.fact-category-otd');
    const sportsBtn = widget.querySelector('.fact-category-sports');

    generalBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      widget.dataset.category = 'general';
      updateCategoryButtons(widget, 'general');
      fetchFact(widget, 'general');
    });

    otdBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      widget.dataset.category = 'otd';
      updateCategoryButtons(widget, 'otd');
      fetchFact(widget, 'otd');
    });

    sportsBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      widget.dataset.category = 'sports';
      updateCategoryButtons(widget, 'sports');
      fetchFact(widget, 'sports');
    });

    const refreshBtn = widget.querySelector('.fact-refresh');
    refreshBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const category = widget.dataset.category || 'general';
      widget.dataset.skipCache = 'true';
      fetchFact(widget, category);
    });
  });
</script>
