---
interface Props {
  lang?: 'en' | 'el';
}

const { lang = 'en' } = Astro.props;
const isEl = lang === 'el';
---

<article class="nasa-widget grid overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/50 md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]" data-lang={lang}>
  <div class="relative min-h-56 overflow-hidden bg-slate-100 dark:bg-slate-800 md:min-h-80">
    <img class="nasa-image absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300" src="" alt="" width="960" height="640" loading="lazy" decoding="async" />
    <div class="nasa-loading absolute inset-0 flex items-center justify-center text-sm text-slate-500 dark:text-slate-300" role="status">
      <span class="animate-pulse" aria-hidden="true">✦</span>
      <span class="ml-2">{isEl ? 'Φόρτωση εικόνας της ημέρας…' : 'Loading today’s image…'}</span>
    </div>
    <div class="nasa-fallback absolute inset-0 hidden items-center justify-center px-6 text-center text-sm text-slate-600 dark:text-slate-300">
      {isEl ? 'Η προεπισκόπηση δεν είναι διαθέσιμη. Μπορείτε να τη δείτε στη NASA.' : 'The preview is unavailable. You can view it on NASA.'}
    </div>
    <span class="nasa-media-type absolute bottom-4 left-4 hidden rounded-full bg-slate-950/80 px-3 py-1 text-xs font-semibold text-white">{isEl ? 'Βίντεο' : 'Video'}</span>
  </div>

  <div class="flex flex-col p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-orange-700 dark:text-orange-400">{isEl ? 'Σήμερα στο διάστημα' : 'Space today'}</p>
      <time class="nasa-date text-xs text-slate-500 dark:text-slate-400"></time>
    </div>
    <h3 class="nasa-title mt-5 text-2xl font-semibold leading-tight tracking-tight">{isEl ? 'Η εικόνα της ημέρας' : 'Today’s image'}</h3>
    <p class="nasa-summary mt-4 text-base leading-7 text-slate-600 dark:text-slate-300">{isEl ? 'Φόρτωση περιγραφής…' : 'Loading description…'}</p>
    <p class="nasa-credit mt-4 hidden text-xs text-slate-500 dark:text-slate-400"></p>
    <a class="nasa-link mt-6 inline-flex min-h-11 items-center self-start rounded-full border border-orange-300 px-4 py-2 text-sm font-semibold text-orange-800 transition-colors hover:bg-orange-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 dark:border-orange-700 dark:text-orange-300 dark:hover:bg-orange-950/40" href="https://science.nasa.gov/apod/" target="_blank" rel="noopener noreferrer">
      {isEl ? 'Περισσότερα στη NASA' : 'Read more at NASA'} <span class="ml-2" aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<script is:inline>
  async function translateNasaText(text) {
    try {
      const query = new URLSearchParams({ text, target: 'el' });
      const response = await fetch(`/api/translate?${query}`);
      if (!response.ok) return null;
      const data = await response.json();
      return data.success && typeof data.text === 'string' ? data.text : null;
    } catch {
      return null;
    }
  }

  async function loadNasaWidget(widget) {
    const isEl = widget.dataset.lang === 'el';
    const title = widget.querySelector('.nasa-title');
    const summary = widget.querySelector('.nasa-summary');
    const date = widget.querySelector('.nasa-date');
    const credit = widget.querySelector('.nasa-credit');
    const link = widget.querySelector('.nasa-link');
    const image = widget.querySelector('.nasa-image');
    const loading = widget.querySelector('.nasa-loading');
    const fallback = widget.querySelector('.nasa-fallback');
    const videoBadge = widget.querySelector('.nasa-media-type');

    const showImageFallback = () => {
      loading?.classList.add('hidden');
      fallback?.classList.remove('hidden');
      fallback?.classList.add('flex');
      image?.classList.add('hidden');
    };

    try {
      const response = await fetch('/api/nasa');
      if (!response.ok) throw new Error('NASA data unavailable');
      const data = await response.json();
      link.href = data.pageUrl;
      date.dateTime = data.date;
      date.textContent = new Date(`${data.date}T12:00:00Z`).toLocaleDateString(isEl ? 'el-GR' : 'en-GB', { day: 'numeric', month: 'short' });
      if (data.credit) {
        credit.textContent = `${isEl ? 'Εικόνα' : 'Image'}: ${data.credit}`;
        credit.classList.remove('hidden');
      }
      if (data.mediaType === 'video') videoBadge?.classList.remove('hidden');

      if (data.imageUrl) {
        let triedOriginal = false;
        image.alt = data.alt || data.title;
        image.onload = () => {
          loading?.classList.add('hidden');
          image.classList.remove('opacity-0');
          image.classList.add('opacity-100');
        };
        image.onerror = () => {
          if (!triedOriginal && data.fallbackImageUrl && data.fallbackImageUrl !== image.src) {
            triedOriginal = true;
            image.src = data.fallbackImageUrl;
          } else {
            showImageFallback();
          }
        };
        image.src = data.imageUrl;
        if (image.complete && image.naturalWidth > 0) image.onload();
      } else {
        showImageFallback();
      }

      if (isEl) {
        const [translatedTitle, translatedSummary] = await Promise.all([
          translateNasaText(data.title),
          translateNasaText(data.summary),
        ]);
        title.textContent = translatedTitle || data.title;
        summary.textContent = translatedSummary || 'Η περιγραφή είναι διαθέσιμη στην πρωτότυπη σελίδα της NASA.';
      } else {
        title.textContent = data.title;
        summary.textContent = data.summary;
      }
    } catch {
      title.textContent = isEl ? 'Η NASA δεν είναι διαθέσιμη αυτή τη στιγμή' : 'NASA is unavailable right now';
      summary.textContent = isEl ? 'Δοκιμάστε ξανά αργότερα ή επισκεφθείτε τη NASA.' : 'Try again later or visit NASA directly.';
      showImageFallback();
    }
  }

  document.querySelectorAll('.nasa-widget').forEach((widget) => {
    if (!('IntersectionObserver' in window)) {
      loadNasaWidget(widget);
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      loadNasaWidget(widget);
    }, { rootMargin: '400px' });
    observer.observe(widget);
  });
</script>
