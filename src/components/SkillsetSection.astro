---
interface SkillCategory {
  name: string;
  description: string;
  accent: string;
  items: string[];
}

interface Copy {
  eyebrow: string;
  title: string;
  categories: SkillCategory[];
}

interface Props {
  lang?: "en" | "el";
}

const { lang = "en" } = Astro.props;

const copy: Record<"en" | "el", Copy> = {
  en: {
    eyebrow: "Skillset",
    title: "Core technologies I use in production",
    categories: [
      {
        name: "Agentic AI Systems",
        description: "Frameworks and patterns for orchestration, tracing, evaluation, and tool-using workflows.",
        accent: "rgb(59 130 246)",
        items: ["OpenAI Agents SDK", "LangChain", "LangGraph", "LangSmith", "AutoGen", "Multi-agent Systems"],
      },
      {
        name: "ML Engineering",
        description: "Core modeling and applied ML work, especially around deep learning, NLP, and production operations.",
        accent: "rgb(16 185 129)",
        items: ["Python", "SQL", "PyTorch", "PyTorch Lightning", "Transformers", "NLP", "MLOps", "LLMOps"],
      },
      {
        name: "Data Platforms & APIs",
        description: "The platform layer for data pipelines, services, storage, and cloud-native delivery.",
        accent: "rgb(249 115 22)",
        items: ["FastAPI", "Microsoft Azure", "Azure Databricks", "PySpark", "MongoDB", "PostgreSQL"],
      },
      {
        name: "Delivery & Observability",
        description: "Tooling that keeps systems versioned, deployable, and visible once they are live.",
        accent: "rgb(236 72 153)",
        items: ["Git", "CI/CD", "Grafana", "Prometheus", "Graylog"],
      },
    ],
  },
  el: {
    eyebrow: "Skillset",
    title: "Core technologies που χρησιμοποιώ στην παραγωγή",
    categories: [
      {
        name: "Agentic AI Systems",
        description: "Frameworks και patterns για orchestration, tracing, evaluation και tool-using workflows.",
        accent: "rgb(59 130 246)",
        items: ["OpenAI Agents SDK", "LangChain", "LangGraph", "LangSmith", "AutoGen", "Multi-agent Systems"],
      },
      {
        name: "ML Engineering",
        description: "Το core layer του modeling και του applied ML, ειδικά σε deep learning, NLP και production operations.",
        accent: "rgb(16 185 129)",
        items: ["Python", "SQL", "PyTorch", "PyTorch Lightning", "Transformers", "NLP", "MLOps", "LLMOps"],
      },
      {
        name: "Data Platforms & APIs",
        description: "Το platform layer για data pipelines, services, storage και cloud-native delivery.",
        accent: "rgb(249 115 22)",
        items: ["FastAPI", "Microsoft Azure", "Azure Databricks", "PySpark", "MongoDB", "PostgreSQL"],
      },
      {
        name: "Delivery & Observability",
        description: "Το tooling που κρατά τα συστήματα versioned, deployable και observable στην παραγωγή.",
        accent: "rgb(236 72 153)",
        items: ["Git", "CI/CD", "Grafana", "Prometheus", "Graylog"],
      },
    ],
  },
};

const T = copy[lang];
---

<section class="px-6 py-8" id="skillset">
  <div class="skillset-header">
    <p class="skillset-eyebrow">{T.eyebrow}</p>
    <h2 class="skillset-title">{T.title}</h2>
  </div>

  <div class="skillset-grid">
    {T.categories.map((category) => (
      <article class="skill-card" style={`--skill-accent: ${category.accent};`}>
        <div class="skill-card__accent" aria-hidden="true"></div>
        <div class="skill-card__header">
          <span class="skill-card__dot" aria-hidden="true"></span>
          <h3>{category.name}</h3>
        </div>
        <p class="skill-card__description">{category.description}</p>
        <div class="skill-pill-list">
          {category.items.map((item) => (
            <span class="skill-pill">{item}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .skillset-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .skillset-eyebrow {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(71 85 105);
  }

  :global(.dark) .skillset-eyebrow {
    color: rgb(148 163 184);
  }

  .skillset-title {
    margin: 0.35rem 0 0;
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .skillset-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .skillset-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skill-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgb(148 163 184 / 0.18);
    padding: 1.25rem;
    background: rgb(255 255 255 / 0.88);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .skill-card:hover {
    transform: translateY(-3px);
    border-color: rgb(148 163 184 / 0.36);
    box-shadow: 0 14px 30px rgb(15 23 42 / 0.08);
  }

  :global(.dark) .skill-card {
    border-color: rgb(71 85 105 / 0.65);
    background: rgb(15 23 42 / 0.62);
  }

  :global(.dark) .skill-card:hover {
    border-color: rgb(100 116 139 / 0.92);
    box-shadow: 0 14px 30px rgb(2 6 23 / 0.22);
  }

  .skill-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--skill-accent), transparent 72%);
  }

  .skill-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .skill-card__header h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .skill-card__dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    flex: 0 0 auto;
    background: var(--skill-accent);
    box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--skill-accent) 18%, transparent);
  }

  .skill-card__description {
    margin: 0.85rem 0 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(71 85 105);
  }

  :global(.dark) .skill-card__description {
    color: rgb(203 213 225);
  }

  .skill-pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--skill-accent) 20%, rgb(203 213 225));
    background: color-mix(in srgb, var(--skill-accent) 8%, transparent);
    color: rgb(226 232 240);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
  }

  :global(:not(.dark)) .skill-pill {
    color: rgb(30 41 59);
  }

  :global(.dark) .skill-pill {
    border-color: color-mix(in srgb, var(--skill-accent) 22%, rgb(71 85 105));
    background: color-mix(in srgb, var(--skill-accent) 10%, rgb(15 23 42));
    color: rgb(226 232 240);
  }

  @media (max-width: 767px) {
    .skill-card {
      padding: 1.1rem;
    }

    .skill-card__description {
      font-size: 0.92rem;
    }
  }
</style>
