---
import creatorsData from "../data/youtube-creators.json";
import videosData from "../data/youtube-videos.json";

interface Props {
  lang?: "en" | "el";
}

const { lang = "en" } = Astro.props;

const t = {
  en: {
    createdBy: "by",
    curated: "Curated Creator",
  },
  el: {
    createdBy: "από",
    curated: "Επιλεγμένος Δημιουργός",
  },
} as const;

const T = t[lang];

interface Creator {
  id: string;
  name: string;
  handle: string;
  avatarUrl?: string;
  curated: boolean;
  description?: string;
}

interface Video {
  title: string;
  videoId: string;
  creatorId: string;
  description?: string;
  duration?: string;
  featured?: boolean;
}

const creators: Creator[] = creatorsData as Creator[];
const videos: Video[] = videosData as Video[];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const featuredVideos = videos
  .filter((v) => v.featured)
  .slice(0, 4)
  .map((v) => ({
    ...v,
    creator: (() => {
      const c = creators.find((c) => c.id === v.creatorId);
      if (!c) return undefined;
      return {
        ...c,
        ...(c.avatarUrl ? { avatarUrl: c.avatarUrl.startsWith('/') ? `${basePath}${c.avatarUrl}` : c.avatarUrl } : {}),
      };
    })(),
  }));
---

<div class="youtube-widget">
  <div class="flex flex-col gap-2">
    {featuredVideos.map((video) => (
      <div
        class="video-card group cursor-pointer"
        data-video-id={video.videoId}
        data-title={video.title}
      >
        <div class="flex gap-3 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
          <div class="relative w-24 h-14 shrink-0 rounded overflow-hidden bg-gray-200 dark:bg-slate-600">
            <img
              src={`https://img.youtube.com/vi/${video.videoId}/mqdefault.jpg`}
              alt={video.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="text-white text-xl">▶</span>
            </div>
            {video.duration && (
              <span class="absolute bottom-0.5 right-0.5 bg-black/80 text-white text-[9px] font-mono px-1 py-0.5 rounded">
                {video.duration}
              </span>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-medium text-gray-800 dark:text-slate-200 line-clamp-2">
              {video.title}
            </div>
            {video.creator && (
              <div class="text-[10px] text-gray-500 dark:text-slate-400 mt-0.5 flex items-center gap-1">
                {video.creator.avatarUrl ? (
                  <img src={video.creator.avatarUrl} alt={video.creator.name} class="w-3.5 h-3.5 rounded-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-3.5 h-3.5 rounded-full bg-red-600 flex items-center justify-center text-white text-[7px] font-bold">{video.creator.name.charAt(0)}</div>
                )}
                <span>{T.createdBy} {video.creator.name}</span>
                {video.creator.curated && (
                  <span class="text-yellow-500" title={T.curated}>★</span>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    ))}

    {featuredVideos.length === 0 && (
      <div class="text-xs text-gray-500 dark:text-slate-400 text-center py-4">
        {lang === "el" ? "Προσθέστε βίντεο στο src/data/youtube-videos.json" : "Add videos to src/data/youtube-videos.json"}
      </div>
    )}
  </div>

  <div
    id="youtube-modal"
    class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4"
  >
    <div class="bg-white dark:bg-slate-800 rounded-xl max-w-4xl w-full max-h-[90vh] overflow-hidden">
      <div class="flex justify-between items-center p-3 border-b border-gray-200 dark:border-gray-700">
        <h3 id="modal-title" class="font-semibold text-gray-800 dark:text-slate-200 truncate pr-4">Video</h3>
        <button id="close-modal" class="text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="aspect-video w-full">
        <iframe id="youtube-player" class="w-full h-full" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const modal = document.getElementById('youtube-modal');
  const youtubePlayer = document.getElementById('youtube-player');
  const modalTitle = document.getElementById('modal-title');
  const closeBtn = document.getElementById('close-modal');

  document.querySelectorAll('.video-card').forEach(card => {
    card.addEventListener('click', () => {
      const videoId = card.dataset.videoId;
      const title = card.dataset.title;

      if (modalTitle) modalTitle.textContent = title;
      if (youtubePlayer) youtubePlayer.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
      if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    });
  });

  closeBtn?.addEventListener('click', () => {
    if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    if (youtubePlayer) youtubePlayer.src = '';
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (youtubePlayer) youtubePlayer.src = '';
    }
  });
</script>

<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>