---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationResources from './PublicationResources.astro';
import { formatPublicationAuthors, hasEqualContribution, publicationVisuals } from '../../utils/publications';
import type { PublicationEntry, PublicationLanguage } from '../../utils/publications';

interface Props {
  post: PublicationEntry;
  lang: PublicationLanguage;
}

const { post, lang } = Astro.props;
const { Content } = await post.render();
const isEl = lang === 'el';
const visual = publicationVisuals[post.slug];
const date = post.data.date;
const siteUrl = Astro.site ?? new URL('https://mpalaourg.dev');
const pageUrl = new URL(`${isEl ? '/el' : ''}/publications/${post.slug}/`, siteUrl).href;
const shareImage = `/publications/${post.slug}/share.png`;
const shareImageUrl = new URL(shareImage, siteUrl).href;
const paperUrl = post.data.doi ? `https://doi.org/${post.data.doi}` : pageUrl;
const citationAuthors = lang === 'el'
  ? (await getEntry('publications', post.slug))?.data.authors ?? post.data.authors
  : post.data.authors;
const labels = isEl
  ? { back: 'Επιστροφή στις δημοσιεύσεις', paper: 'Ερευνητική δημοσίευση', equal: '* Ίση συνεισφορά', abstract: 'Περίληψη', figure: 'Σχήμα από τη δημοσίευση', openFigure: 'Άνοιγμα σχήματος σε πλήρες μέγεθος', notes: 'Η εργασία με λίγα λόγια' }
  : { back: 'Back to publications', paper: 'Research paper', equal: '* Equal contribution', abstract: 'Abstract', figure: 'Figure from the paper', openFigure: 'Open full-size figure', notes: 'The paper in brief' };
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  '@id': pageUrl,
  url: pageUrl,
  name: post.data.title,
  headline: post.data.title,
  description: post.data.summary,
  abstract: post.data.abstract,
  inLanguage: lang,
  datePublished: date.toISOString().slice(0, 10),
  author: citationAuthors.map((name) => ({ '@type': 'Person', name })),
  image: shareImageUrl,
  sameAs: paperUrl,
  identifier: post.data.doi ? { '@type': 'PropertyValue', propertyID: 'DOI', value: post.data.doi } : undefined,
};
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<BaseLayout
  title={`${post.data.title} | ${isEl ? 'Δημοσιεύσεις | Γιώργος Μπαλαούρας' : 'Publications | Georgios Balaouras'}`}
  description={post.data.summary}
  ogImage={shareImage}
  ogImageAlt={`${post.data.title} — ${post.data.publication_short}`}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta name="citation_title" content={post.data.title} />
    {citationAuthors.map((author) => <meta name="citation_author" content={author} />)}
    <meta name="citation_publication_date" content={`${date.getUTCFullYear()}/${date.getUTCMonth() + 1}/${date.getUTCDate()}`} />
    <meta name="citation_conference_title" content={post.data.publication} />
    {post.data.doi && <meta name="citation_doi" content={post.data.doi} />}
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <header>
      <a href={isEl ? '/el/publications' : '/publications'} class="mb-8 inline-flex min-h-10 items-center text-sm font-medium text-gray-600 hover:text-orange-700 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 dark:text-slate-300 dark:hover:text-orange-400">
        <span aria-hidden="true">←</span>&nbsp;{labels.back}
      </a>

      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-orange-700 dark:text-orange-400">
        {labels.paper} <span aria-hidden="true">·</span> {post.data.publication_short} {date.getFullYear()}
      </p>
      <h1 class="mb-5 text-left text-[1.625rem] font-bold leading-tight tracking-tight sm:text-justify sm:text-4xl lg:text-[2.625rem]">{post.data.title}</h1>
      <p class="mb-6 text-justify text-lg leading-8 text-gray-700 dark:text-slate-200 sm:text-xl">{post.data.summary}</p>

      <p class="mb-1 text-sm text-gray-600 dark:text-slate-400">
        {post.data.publication} <span aria-hidden="true">·</span> {date.toLocaleDateString(isEl ? 'el-GR' : 'en-GB', { month: 'long', year: 'numeric' })}
      </p>
      <p class="text-sm leading-6 text-gray-700 dark:text-slate-300">{formatPublicationAuthors(post)}</p>
      {hasEqualContribution(post) && <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">{labels.equal}</p>}
    </header>

    <div class="mt-7"><PublicationResources post={post} lang={lang} /></div>

    <section aria-labelledby="publication-abstract" class="mt-10 border-t border-gray-200 pt-8 dark:border-slate-700">
      <h2 id="publication-abstract" class="mb-4 text-2xl font-semibold tracking-tight">{labels.abstract}</h2>
      <p class="text-justify text-base leading-8 text-gray-700 dark:text-slate-300">{post.data.abstract}</p>
    </section>

    {post.data.featuredImage && (
      <figure class="mt-10">
        <a
          href={post.data.featuredImage}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${labels.openFigure}: ${post.data.title}`}
          class="block overflow-hidden rounded-2xl border border-gray-200 bg-slate-100 p-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 dark:border-slate-700 dark:bg-slate-800 sm:p-5"
        >
          <img
            src={post.data.featuredImage}
            alt={visual?.alt[lang] ?? post.data.title}
            width={visual?.width ?? 1200}
            height={visual?.height ?? 800}
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-contain"
          />
        </a>
        <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-2 text-sm text-gray-500 dark:text-slate-400">
          <span>{labels.figure}: {visual?.caption[lang]}</span>
          <a href={post.data.featuredImage} target="_blank" rel="noopener noreferrer" class="font-medium text-orange-700 hover:underline dark:text-orange-400">
            {labels.openFigure} ↗
          </a>
        </figcaption>
      </figure>
    )}

    <section aria-labelledby="publication-notes" class="mt-12 border-t border-gray-200 pt-8 dark:border-slate-700">
      <h2 id="publication-notes" class="mb-5 text-2xl font-semibold tracking-tight">{labels.notes}</h2>
      <div class="prose prose-neutral max-w-none text-justify dark:prose-invert">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>
