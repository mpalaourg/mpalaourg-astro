---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationResources from './PublicationResources.astro';
import { formatPublicationAuthors, hasEqualContribution, publicationVisuals } from '../../utils/publications';
import type { PublicationEntry, PublicationLanguage } from '../../utils/publications';

interface Props {
  posts: PublicationEntry[];
  lang: PublicationLanguage;
}

const { posts, lang } = Astro.props;
const isEl = lang === 'el';
const prefix = isEl ? '/el' : '';
const labels = isEl
  ? {
      title: 'Δημοσιεύσεις',
      intro: 'Τρεις εργασίες για την εποπτευόμενη και μη εποπτευόμενη περίληψη βίντεο και την επεξήγηση των αποτελεσμάτων της.',
      equal: '* Ίση συνεισφορά',
      citations: 'Δείτε αναφορές',
      citationSource: 'Ο αριθμός αναφορών προέρχεται από το Semantic Scholar. Ο σύνδεσμος ανοίγει το Google Scholar.',
      imageLink: 'Προβολή δημοσίευσης',
    }
  : {
      title: 'Publications',
      intro: 'Three papers on supervised and unsupervised video summarization, and on explaining the resulting summaries.',
      equal: '* Equal contribution',
      citations: 'View citations',
      citationSource: 'Citation count from Semantic Scholar. Link opens Google Scholar.',
      imageLink: 'View publication',
    };
---

<BaseLayout
  title={isEl ? 'Δημοσιεύσεις | Γεώργιος Μπαλαούρας' : 'Publications | Georgios Balaouras'}
  description={isEl
    ? 'Ερευνητικές δημοσιεύσεις του Γιώργου Μπαλαούρα για τη σύνοψη βίντεο, τους μηχανισμούς προσοχής και την εξηγήσιμη μηχανική μάθηση.'
    : 'Research publications by Georgios Balaouras on video summarization, attention mechanisms, and explainable machine learning.'}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-8 max-w-3xl sm:mb-10">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">
        {isEl ? 'Έρευνα' : 'Research'}
      </p>
      <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">{labels.title}</h1>
      <p class="text-justify text-base leading-7 text-gray-600 dark:text-slate-300 sm:text-lg">{labels.intro}</p>
    </header>

    <div class="grid gap-5 sm:gap-6">
      {posts.map((post) => {
        const visual = publicationVisuals[post.slug];
        const detailUrl = `${prefix}/publications/${post.slug}`;
        return (
          <article class="grid min-w-0 gap-6 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800/50 sm:p-7 md:grid-cols-[minmax(0,1fr)_14rem] md:items-start lg:grid-cols-[minmax(0,1fr)_17rem]">
            <div class="min-w-0">
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-orange-700 dark:text-orange-400">
                {post.data.publication_short} <span aria-hidden="true">·</span> {post.data.date.getFullYear()}
              </p>
              <h2 class="mb-3 text-justify text-2xl font-semibold leading-tight tracking-tight sm:text-[1.7rem]">
                <a href={detailUrl} class="hover:text-orange-700 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 dark:hover:text-orange-400">
                  {post.data.title}
                </a>
              </h2>
              <p class="mb-4 max-w-3xl text-justify text-base leading-7 text-gray-700 dark:text-slate-200">{post.data.summary}</p>
              <p class="mb-1 text-sm text-gray-600 dark:text-slate-400">
                {post.data.publication} <span aria-hidden="true">·</span> {post.data.date.toLocaleDateString(isEl ? 'el-GR' : 'en-GB', { month: 'long', year: 'numeric' })}
              </p>
              <p class="text-sm leading-6 text-gray-700 dark:text-slate-300">{formatPublicationAuthors(post)}</p>
              {hasEqualContribution(post) && <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">{labels.equal}</p>}

              <div class="mt-5"><PublicationResources post={post} lang={lang} /></div>

              {post.data.doi && (
                <div class="mt-4" data-citation-wrapper data-doi={post.data.doi} data-lang={lang}>
                  <a
                    href={`https://scholar.google.com/scholar?q=${encodeURIComponent(post.data.title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={labels.citationSource}
                    class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-3 py-1.5 text-xs font-medium text-blue-900 hover:bg-blue-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-900/40 dark:text-blue-200 dark:hover:bg-blue-800/60"
                  >
                    <span data-citation-count>{labels.citations}</span>
                    <span aria-hidden="true">·</span>
                    <span>Google Scholar</span>
                    <span class="sr-only">({labels.citationSource})</span>
                  </a>
                </div>
              )}
            </div>

            {post.data.featuredImage && (
              <figure class="min-w-0">
                <a href={detailUrl} aria-label={`${labels.imageLink}: ${post.data.title}`} class="block rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">
                  <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-2xl bg-slate-100 p-3 dark:bg-slate-700/60">
                    <img
                      src={post.data.featuredImage}
                      alt={visual?.alt[lang] ?? post.data.title}
                      width={visual?.width ?? 1200}
                      height={visual?.height ?? 800}
                      loading="lazy"
                      decoding="async"
                      class="max-h-full max-w-full object-contain"
                    />
                  </div>
                </a>
                <figcaption class="sr-only">{visual?.caption[lang]}</figcaption>
              </figure>
            )}
          </article>
        );
      })}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('[data-citation-wrapper]').forEach((wrapper) => {
      const countElement = wrapper.querySelector('[data-citation-count]');
      const doi = wrapper.dataset.doi;
      if (!countElement || !doi) return;

      fetch(`/api/citations?doi=${encodeURIComponent(doi)}`)
        .then((response) => {
          if (!response.ok) throw new Error(`Citation request failed: ${response.status}`);
          return response.json();
        })
        .then((data) => {
          if (typeof data.citationCount === 'number') {
            const count = data.citationCount.toLocaleString(wrapper.dataset.lang === 'el' ? 'el-GR' : 'en-US');
            countElement.textContent = `${count} ${wrapper.dataset.lang === 'el' ? 'αναφορές' : 'citations'}`;
          }
        })
        .catch(() => {
          // The link remains useful even when the live count is unavailable.
        });
    });
  </script>
</BaseLayout>
