---
import type { PublicationEntry, PublicationLanguage } from '../../utils/publications';

interface Props {
  post: PublicationEntry;
  lang: PublicationLanguage;
}

const { post, lang } = Astro.props;
const labels = lang === 'el'
  ? { pdf: 'PDF', doi: 'DOI', code: 'Κώδικας', video: 'Βίντεο', slides: 'Διαφάνειες', project: 'Έργο', dataset: 'Δεδομένα', newTab: 'ανοίγει σε νέα καρτέλα' }
  : { pdf: 'PDF', doi: 'DOI', code: 'Code', video: 'Video', slides: 'Slides', project: 'Project', dataset: 'Dataset', newTab: 'opens in a new tab' };

const resources = [
  { label: labels.pdf, href: post.data.url_pdf, primary: true },
  { label: labels.doi, href: post.data.doi ? `https://doi.org/${post.data.doi}` : undefined },
  { label: labels.code, href: post.data.url_code },
  { label: labels.video, href: post.data.url_video },
  { label: labels.slides, href: post.data.url_slides },
  { label: labels.project, href: post.data.url_project },
  { label: labels.dataset, href: post.data.url_dataset },
].filter((resource) => resource.href);
---

<div role="group" class="flex flex-wrap items-center gap-2" aria-label={lang === 'el' ? 'Σύνδεσμοι δημοσίευσης' : 'Publication links'}>
  {resources.map((resource) => (
    <a
      href={resource.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'inline-flex min-h-10 items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500',
        resource.primary
          ? 'bg-orange-600 text-white hover:bg-orange-500'
          : 'border border-slate-300 bg-white text-slate-800 hover:border-orange-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:border-orange-500',
      ]}
    >
      {resource.label}<span class="sr-only"> ({labels.newTab})</span>
    </a>
  ))}
</div>
