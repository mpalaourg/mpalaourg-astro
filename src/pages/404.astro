---
import BaseLayout from "../layouts/BaseLayout.astro";

const isEl = Astro.url.pathname === "/el" || Astro.url.pathname.startsWith("/el/");
const copy = isEl ? {
  title: "Η σελίδα δεν βρέθηκε",
  description: "Η σελίδα που ψάχνετε δεν υπάρχει ή έχει μετακινηθεί.",
  eyebrow: "Χαθήκαμε λίγο;",
  heading: "Αυτή η σελίδα δεν υπάρχει.",
  body: "Η διεύθυνση ίσως άλλαξε. Επιστρέψτε στην αρχική ή δείτε τα έργα, τις δημοσιεύσεις και τη Formula 1.",
  home: "Αρχική σελίδα",
  projects: "Έργα",
  publications: "Δημοσιεύσεις",
  formula: "Formula 1",
  prefix: "/el",
} : {
  title: "Page not found",
  description: "The page you were looking for does not exist or has moved.",
  eyebrow: "Lost your way?",
  heading: "This page does not exist.",
  body: "The address may have changed. Head home or explore my projects, publications, and Formula 1.",
  home: "Home",
  projects: "Projects",
  publications: "Publications",
  formula: "Formula 1",
  prefix: "",
};
---

<BaseLayout title={`${copy.title} | Georgios Balaouras`} description={copy.description} noindex>
  <section class="mx-auto flex min-h-[65vh] max-w-7xl items-center px-4 py-16 sm:px-6" aria-labelledby="not-found-heading">
    <div class="relative w-full overflow-hidden rounded-[2rem] border border-slate-200 bg-gradient-to-br from-white via-slate-50 to-orange-50 p-8 shadow-sm dark:border-slate-700 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 sm:p-14">
      <span class="pointer-events-none absolute -right-7 -top-16 select-none text-[12rem] font-black leading-none tracking-tighter text-slate-900/[0.04] dark:text-white/[0.04] sm:text-[18rem]" aria-hidden="true">404</span>
      <div class="relative w-full">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">404 · {copy.eyebrow}</p>
        <h1 id="not-found-heading" class="mt-5 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl">{copy.heading}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300 xl:whitespace-nowrap">{copy.body}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${copy.prefix}/`} class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">{copy.home} →</a>
          <a href={`${copy.prefix}/projects`} class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-slate-500 dark:border-slate-600 dark:text-slate-100 dark:hover:border-slate-400">{copy.projects}</a>
          <a href={`${copy.prefix}/publications`} class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-slate-500 dark:border-slate-600 dark:text-slate-100 dark:hover:border-slate-400">{copy.publications}</a>
          <a href={`${copy.prefix}/formula`} class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-slate-500 dark:border-slate-600 dark:text-slate-100 dark:hover:border-slate-400">{copy.formula}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
