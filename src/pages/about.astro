---
import BaseLayout from "../layouts/BaseLayout.astro";
import NASAWidget from "../components/NASAWidget.astro";
import F1RaceWidget from "../components/F1RaceWidget.astro";
import PlayfulSignalsSection from "../components/PlayfulSignalsSection.astro";
---

<BaseLayout title="About | Georgios Balaouras" description="Get to know Georgios Balaouras beyond machine learning: coffee, travel, Formula 1, music, and the curiosities that shape how he thinks.">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <section class="overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white/40 shadow-sm dark:border-slate-700 dark:bg-slate-900/30">
      <div class="relative h-56 overflow-hidden md:h-64">
        <img
          src="/media/cover.jpg"
          alt="About cover"
          class="h-full w-full object-cover object-[center_35%]"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/45 via-slate-900/20 to-slate-900/35"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/45 via-transparent to-transparent"></div>
      </div>

      <div class="relative px-4 pb-8 pt-0 sm:px-6 md:px-8">
        <div class="-mt-16 mb-6 md:-mt-20">
          <img
            src="/media/avatar.jpg"
            alt="Georgios Balaouras"
            class="h-32 w-32 rounded-[2rem] object-cover shadow-xl ring-4 ring-white dark:ring-slate-900 md:h-36 md:w-36"
          />
        </div>

        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-orange-600 dark:text-orange-400">About</p>
        <h1 class="mt-4 text-4xl font-bold leading-[1.02] md:text-5xl xl:text-[4.1rem]">What I enjoy and how I think</h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-slate-400">
          I like work that is clear, useful, and grounded in real problems. Outside that, the same instinct shows up in simpler things: coffee, travel, Formula 1, rembetika, and small curiosities worth a second look.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/projects" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-medium hover:border-slate-500 dark:border-slate-600 dark:hover:border-slate-400">Projects</a>
          <a href="/publications" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-medium hover:border-slate-500 dark:border-slate-600 dark:hover:border-slate-400">Publications</a>
          <a href="/formula" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-medium hover:border-slate-500 dark:border-slate-600 dark:hover:border-slate-400">Formula</a>
        </div>
      </div>
    </section>

    <section class="mt-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400">Beyond Work</p>
        <h2 class="mt-3 text-3xl font-bold">A few steady interests that stay with me away from the keyboard</h2>
        <p class="mt-4 text-base leading-7 text-gray-700 dark:text-slate-300">
          I keep returning to things that reward a second look. NASA's image of the day is one of them. I like the mix of science, scale, and quiet wonder, especially when a single image says more than a long explanation.
        </p>
      </div>
    </section>

    <section class="mx-auto mt-10 max-w-5xl">
      <NASAWidget lang="en" variant="contained" />
    </section>

    <section class="mt-16">
      <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500 dark:text-slate-400">Current Obsessions</p>
        <h2 class="mt-3 text-3xl font-bold">The recurring themes are familiar, but never dull</h2>
        <p class="mt-4 text-base leading-7 text-gray-600 dark:text-slate-400">
          Most of my attention outside work returns to a small set of things I never really tire of: coffee, travel, series, race weekends, and music with character.
        </p>
      </div>

      <div id="slider" class="relative overflow-hidden rounded-[2rem] border border-gray-200 bg-slate-900 shadow-lg dark:border-slate-700" data-interval="10000">
        <div class="absolute inset-0">
          <img id="slider-bg" src="/media/images/coffee.webp" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover opacity-50" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/68 via-black/28 to-transparent"></div>
        <div class="relative z-10 flex min-h-[18rem] items-end p-8 md:min-h-[20rem] md:p-10">
          <div>
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-orange-300">Lately</p>
            <div class="slider-content" aria-live="off" aria-atomic="true">
              <p class="text-2xl font-semibold leading-tight text-white drop-shadow-lg md:text-[2.15rem]">Strong coffee is still part of the daily routine</p>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3" role="group" aria-label="Slideshow controls">
        <div class="flex gap-1">
          <button type="button" class="slider-dot h-8 w-8 rounded-full border-[10px] border-transparent bg-clip-padding bg-slate-600" data-index="0" aria-label="Coffee" aria-pressed="true"></button>
          <button type="button" class="slider-dot h-8 w-8 rounded-full border-[10px] border-transparent bg-clip-padding bg-slate-400" data-index="1" aria-label="Travel" aria-pressed="false"></button>
          <button type="button" class="slider-dot h-8 w-8 rounded-full border-[10px] border-transparent bg-clip-padding bg-slate-400" data-index="2" aria-label="Series" aria-pressed="false"></button>
          <button type="button" class="slider-dot h-8 w-8 rounded-full border-[10px] border-transparent bg-clip-padding bg-slate-400" data-index="3" aria-label="Formula 1" aria-pressed="false"></button>
          <button type="button" class="slider-dot h-8 w-8 rounded-full border-[10px] border-transparent bg-clip-padding bg-slate-400" data-index="4" aria-label="Music" aria-pressed="false"></button>
        </div>
        <button id="slider-playback" type="button" aria-pressed="false" class="rounded-full border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:border-slate-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500 dark:border-slate-600 dark:text-slate-200">Pause slides</button>
      </div>
    </section>

    <PlayfulSignalsSection lang="en" />

    <section class="mt-16 mb-8">
      <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500 dark:text-slate-400">Race Weekend</p>
        <h2 class="mt-3 text-3xl font-bold">Formula 1 is still one of the easiest ways to pull me in</h2>
        <p class="mt-4 text-base leading-7 text-gray-600 dark:text-slate-400">
          It is one of the few things I follow with both emotion and analysis. I enjoy the race weekends, the strategy, and the way a full season slowly builds its own story.
        </p>
      </div>
      <F1RaceWidget lang="en" />
    </section>
  </div>

  <script>
    const slides = [
      { text: "Strong coffee is still part of the daily routine", bg: "/media/images/coffee.webp" },
      { text: "I like discovering new cities and walking them slowly", bg: "/media/images/travel.webp" },
      { text: "I rarely stay away from a good series for long", bg: "/media/images/series.webp" },
      { text: "Race weekends still get my full attention", bg: "/media/images/f1.webp" },
      { text: "Rembetika remains one of the sounds I return to most", bg: "/media/images/music.webp" },
    ];

    const bgImage = document.getElementById('slider-bg') as HTMLImageElement | null;
    const slideContent = document.querySelector('.slider-content');
    const slideText = slideContent?.querySelector('p');
    const dots = document.querySelectorAll<HTMLButtonElement>('.slider-dot');
    const playbackButton = document.getElementById('slider-playback');
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let currentSlide = 0;
    let isPaused = motionPreference.matches;
    let timer: ReturnType<typeof setInterval> | undefined;

    function showSlide(index: number) {
      currentSlide = index;
      if (bgImage) bgImage.src = slides[index].bg;
      if (slideText) slideText.textContent = slides[index].text;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-slate-600', i === index);
        dot.classList.toggle('bg-slate-400', i !== index);
        dot.setAttribute('aria-pressed', String(i === index));
      });
    }

    function updatePlayback() {
      if (timer) clearInterval(timer);
      timer = undefined;
      if (!isPaused) timer = setInterval(() => showSlide((currentSlide + 1) % slides.length), 10000);
      slideContent?.setAttribute('aria-live', isPaused ? 'polite' : 'off');
      if (playbackButton) {
        playbackButton.textContent = isPaused ? 'Play slides' : 'Pause slides';
        playbackButton.setAttribute('aria-pressed', String(isPaused));
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        showSlide(Number(dot.dataset.index ?? 0));
        isPaused = true;
        updatePlayback();
      });
    });
    playbackButton?.addEventListener('click', () => {
      isPaused = !isPaused;
      updatePlayback();
    });
    motionPreference.addEventListener('change', (event) => {
      if (event.matches) {
        isPaused = true;
        updatePlayback();
      }
    });
    updatePlayback();
  </script>
</BaseLayout>
