---
export const prerender = true;
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import F1ChampionsArchive from "../../../../components/F1ChampionsArchive.astro";
import { driverChampions, constructorChampions } from "../../../../data/f1Champions";

export function getStaticPaths() {
  const latestDecade = Math.floor(driverChampions[0].year / 10) * 10;
  return ([
    ["drivers", driverChampions],
    ["constructors", constructorChampions],
  ] as const).flatMap(([view, champions]) =>
    [...new Set(champions.map(({ year }) => Math.floor(year / 10) * 10))]
      .filter((decade) => view !== "drivers" || decade !== latestDecade)
      .map((decade) => ({ params: { view, decade: String(decade) }, props: { view, decade } })),
  );
}

const { view, decade } = Astro.props;
const range = `${decade}s`;
---

<BaseLayout title={`${range} Formula 1 ${view === "drivers" ? "Drivers’" : "Constructors’"} Champions | Georgios Balaouras`} description={`Explore the ${range} Formula 1 ${view === "drivers" ? "drivers’" : "constructors’"} champions, their teams, and season statistics.`}>
  <F1ChampionsArchive lang="en" view={view} decade={decade} />
</BaseLayout>
