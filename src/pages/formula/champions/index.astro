---
export const prerender = true;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import F1ChampionsArchive from "../../../components/F1ChampionsArchive.astro";
import { constructorChampions } from "../../../data/f1Champions";
const latestDecade = Math.floor(constructorChampions[0].year / 10) * 10;
---

<BaseLayout title="Formula 1 World Champions | Georgios Balaouras" description="Explore Formula 1 drivers’ and constructors’ champions by decade, with title-winning teams and season statistics.">
  <script slot="head" is:inline define:vars={{ latestDecade }}>
    if (new URLSearchParams(location.search).get("view") === "constructors") {
      location.replace(`${location.pathname}constructors/${latestDecade}/`);
    }
  </script>
  <F1ChampionsArchive lang="en" />
</BaseLayout>
