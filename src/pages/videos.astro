---
import BaseLayout from "../layouts/BaseLayout.astro";
import creatorsData from "../data/youtube-creators.json";
import videosData from "../data/youtube-videos.json";

interface Creator {
  id: string;
  name: string;
  handle: string;
  avatarUrl?: string;
  curated: boolean;
  description?: string;
}

interface Video {
  title: string;
  videoId: string;
  creatorId: string;
  description?: string;
  duration?: string;
  featured?: boolean;
}

const creators: Creator[] = creatorsData as Creator[];
const videos: Video[] = videosData as Video[];

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefixAvatar = (c: Creator) => ({
  ...c,
  ...(c.avatarUrl ? { avatarUrl: c.avatarUrl.startsWith('/') ? `${basePath}${c.avatarUrl}` : c.avatarUrl } : {}),
});

const creatorsPrefixed = creators.map(prefixAvatar);
const curatedCreators = creatorsPrefixed.filter((c) => c.curated);

const allVideos = videos.map((v) => ({
  ...v,
  creator: creatorsPrefixed.find((c) => c.id === v.creatorId),
}));
---

<BaseLayout title="Videos | Georgios Balaouras">
  <main class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-8">YouTube Videos</h1>

    {curatedCreators.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <span class="text-yellow-500">★</span>
          Curated Creators
        </h2>
        <p class="text-gray-600 dark:text-slate-400 mb-6">My favorite YouTube channels.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {curatedCreators.map((creator) => (
            <a
              href={`https://www.youtube.com/@${creator.handle}`}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-4 p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400 hover:shadow-md transition-all"
              data-creator-handle={creator.handle}
            >
              {creator.avatarUrl ? (
                <img
                  src={creator.avatarUrl}
                  alt={creator.name}
                  class="w-12 h-12 rounded-full object-cover border-2 border-gray-200 dark:border-gray-600 shrink-0"
                  loading="lazy"
                />
              ) : (
                <div class="w-12 h-12 rounded-full bg-red-600 flex items-center justify-center text-white font-bold text-lg shrink-0">
                  {creator.name.charAt(0)}
                </div>
              )}
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-gray-800 dark:text-slate-200 flex items-center gap-2">
                  {creator.name}
                  <span class="text-yellow-500 text-sm">★</span>
                </div>
                {creator.description && (
                  <p class="text-sm text-gray-500 dark:text-slate-400 mt-0.5">
                    {creator.description}
                  </p>
                )}
              </div>
              <svg class="w-5 h-5 text-gray-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    {allVideos.length > 0 && (
      <section>
        <h2 class="text-xl font-bold mb-4">Featured Videos</h2>
        <p class="text-gray-600 dark:text-slate-400 mb-6">Hand-picked videos worth watching.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allVideos.map((video) => (
            <div
              class="video-card group cursor-pointer rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden hover:border-blue-500 dark:hover:border-blue-400 transition-colors"
              data-video-id={video.videoId}
              data-title={video.title}
            >
              <div class="relative aspect-video">
                <img
                  src={`https://img.youtube.com/vi/${video.videoId}/hqdefault.jpg`}
                  alt={video.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <div class="w-16 h-16 rounded-full bg-red-600 flex items-center justify-center">
                    <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
                {video.duration && (
                  <span class="absolute bottom-2 right-2 bg-black/80 text-white text-xs font-mono px-1.5 py-0.5 rounded">
                    {video.duration}
                  </span>
                )}
              </div>
              <div class="p-3">
                <h3 class="font-semibold text-gray-800 dark:text-slate-200 line-clamp-2 mb-1">
                  {video.title}
                </h3>
                {video.description && (
                  <p class="text-xs text-gray-500 dark:text-slate-400 line-clamp-2 mb-1">
                    {video.description}
                  </p>
                )}
                {video.creator && (
                  <div class="flex items-center gap-1.5 mt-1">
                    {video.creator.avatarUrl ? (
                      <img src={video.creator.avatarUrl} alt={video.creator.name} class="w-5 h-5 rounded-full object-cover" loading="lazy" />
                    ) : (
                      <div class="w-5 h-5 rounded-full bg-red-600 flex items-center justify-center text-white text-[8px] font-bold">{video.creator.name.charAt(0)}</div>
                    )}
                    <span class="text-sm text-gray-500 dark:text-slate-400">{video.creator.name}</span>
                    {video.creator.curated && <span class="text-yellow-500 text-sm">★</span>}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {allVideos.length === 0 && curatedCreators.length === 0 && (
      <div class="text-center py-12 text-gray-500 dark:text-slate-400">
        <p>Add videos to <code class="bg-gray-100 dark:bg-slate-700 px-1 rounded">src/data/youtube-videos.json</code></p>
      </div>
    )}

    <div
      id="youtube-modal"
      class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4"
    >
      <div class="bg-white dark:bg-slate-800 rounded-xl max-w-4xl w-full max-h-[90vh] overflow-hidden">
        <div class="flex justify-between items-center p-3 border-b border-gray-200 dark:border-gray-700">
          <h3 id="modal-title" class="font-semibold text-gray-800 dark:text-slate-200 truncate pr-4">Video</h3>
          <button id="close-modal" class="text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="aspect-video w-full">
          <iframe id="youtube-player" class="w-full h-full" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  const modal = document.getElementById('youtube-modal');
  const youtubePlayer = document.getElementById('youtube-player');
  const modalTitle = document.getElementById('modal-title');
  const closeBtn = document.getElementById('close-modal');

  document.querySelectorAll('.video-card').forEach(card => {
    card.addEventListener('click', () => {
      if (modalTitle) modalTitle.textContent = card.dataset.title;
      if (youtubePlayer) youtubePlayer.src = `https://www.youtube.com/embed/${card.dataset.videoId}?autoplay=1`;
      if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    });
  });

  closeBtn?.addEventListener('click', () => {
    if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    if (youtubePlayer) youtubePlayer.src = '';
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (youtubePlayer) youtubePlayer.src = '';
    }
  });
</script>

<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>